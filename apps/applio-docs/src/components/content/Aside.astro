---
interface Props { type?: "note" | "tip" | "caution" | "danger"; title?: string; }
const { type = "note", title = type.charAt(0).toUpperCase() + type.slice(1) } = Astro.props;
---
<aside class={`callout callout-${type}`} aria-label={title}>
  <p class="callout-title">{title}</p>
  <slot />
</aside>
