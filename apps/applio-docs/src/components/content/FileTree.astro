---
import Icon from "../../../../../shared/Icon.astro";
import FileTreeNode from "./FileTreeNode.astro";
import type { FileTreeEntry } from "./file-tree";
interface Props { title?: string; items: FileTreeEntry[]; }
const { title = "File structure", items } = Astro.props;
function formatEntries(entries: FileTreeEntry[], depth = 0): string {
  return entries.map(entry => {
    const name = entry.children !== undefined ? `${entry.name.replace(/\/+$/, "")}/` : entry.name;
    const line = `${"  ".repeat(depth)}${name}`;
    return entry.children?.length ? `${line}\n${formatEntries(entry.children, depth + 1)}` : line;
  }).join("\n");
}
---
<docs-file-tree data-tree-text={formatEntries(items)}>
  <figure class="file-tree" aria-label={title}>
    <figcaption class="file-tree-heading"><span class="icon-label"><Icon name="folder-tree" size={16} />{title}</span><button type="button" class="file-tree-copy icon-label" aria-label="Copy file structure" hidden><Icon name="copy" size={14} /><span data-copy-label>Copy</span></button></figcaption>
    <div class="file-tree-body"><ul class="file-tree-list" aria-label={title}>{items.map(entry => <FileTreeNode entry={entry} />)}</ul></div>
  </figure>
  <span class="sr-only" role="status"></span>
</docs-file-tree>
<script>
  class DocsFileTree extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = "true";
      const button = this.querySelector<HTMLButtonElement>(".file-tree-copy")!;
      const label = this.querySelector<HTMLElement>("[data-copy-label]")!;
      const status = this.querySelector<HTMLElement>("[role='status']")!;
      button.hidden = false;
      let reset: ReturnType<typeof setTimeout>;
      button.addEventListener("click", async () => {
        clearTimeout(reset);
        try {
          await navigator.clipboard.writeText(this.dataset.treeText ?? "");
          label.textContent = "Copied";
          status.textContent = "File structure copied.";
        } catch {
          label.textContent = "Copy unavailable";
          status.textContent = "Copy is unavailable. You can select and copy the file names.";
        }
        reset = setTimeout(() => { label.textContent = "Copy"; }, 2000);
      });
    }
  }
  if (!customElements.get("docs-file-tree")) customElements.define("docs-file-tree", DocsFileTree);
</script>
