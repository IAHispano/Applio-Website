---
import Icon from "../../../../../shared/Icon.astro";

interface Props {
	value: string;
	description?: string;
	kind?: "folder" | "file";
}

const { value, description, kind = "folder" } = Astro.props;
---

<div class="docs-path">
  <div class="docs-path-content">
    <span class="docs-path-icon"><Icon name={kind === "folder" ? "folder" : "file"} size={16} /></span>
    <div class="docs-path-text">
      <code class="docs-path-value">{value}</code>
      {description && <p class="docs-path-description">{description}</p>}
    </div>
  </div>
</div>
