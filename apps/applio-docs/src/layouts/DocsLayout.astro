---
import Icon from "../../../../shared/Icon.astro";
import "@fontsource-variable/syne";
import "../../../../shared/theme.css";
import "../styles/docs.css";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import { ecosystem } from "../../../../shared/ecosystem";
import { navigation, pages } from "../lib/navigation";

interface Props { entry: CollectionEntry<"docs">; headings: MarkdownHeading[]; }
const { entry, headings } = Astro.props;
const path = entry.id === "index" ? "/" : `/${entry.id}/`;
const currentIndex = pages.findIndex(page => page.href === path);
const previous = pages[currentIndex - 1];
const next = currentIndex >= 0 ? pages[currentIndex + 1] : undefined;
const group = pages[currentIndex]?.group ?? "Documentation";
const toc = headings.filter(heading => heading.depth >= 2 && heading.depth <= 3);
const canonical = new URL(path, ecosystem.links.docs);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{entry.data.title} · Applio Docs</title>
    <meta name="description" content={entry.data.description} />
    <meta name="theme-color" content="#09090b" />
    <meta property="og:title" content={`${entry.data.title} · Applio Docs`} />
    <meta property="og:description" content={entry.data.description} />
    <meta property="og:image" content={new URL("/opengraph-image.png", ecosystem.links.docs).href} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    {entry.id === "404" && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="docs-header">
      <a class="brand" href="/" aria-label="Applio documentation home">
        <img src="/applio-logo.svg" width="22" height="26" alt="" />
        <span>Applio</span><span class="brand-badge">Docs</span>
      </a>
      <button class="search-trigger" type="button" data-open-search aria-haspopup="dialog"><span class="icon-label"><Icon name="search" /> Search documentation</span><kbd>Ctrl K</kbd></button>
      <nav class="header-links" aria-label="Applio links">
        <a href={ecosystem.links.website}>Website <Icon name="external-link" size={12} /></a>
        <a class="download-link" href={ecosystem.links.download}>Download Applio <Icon name="download" /></a>
      </nav>
    </header>
    <div class="docs-shell">
      <aside class="sidebar">
        <details class="mobile-navigation" open>
          <summary>Browse documentation <Icon name="chevron-down" size={16} /></summary>
          <nav aria-label="Documentation">
            {navigation.map(section => <section class="nav-group">
              <h2>{section.label}</h2>
              <ul>{section.items.map(([label, href]) => <li><a href={href} aria-current={href === path ? "page" : undefined}>{label}{href.startsWith("https:") && <Icon name="external-link" />}</a></li>)}</ul>
            </section>)}
          </nav>
          <div class="sidebar-footer"><a href={ecosystem.links.discord}>Community & support <Icon name="external-link" size={12} /></a><a href={ecosystem.projects.docs.repository}>Contribute on GitHub <Icon name="external-link" size={12} /></a></div>
        </details>
      </aside>
      <main id="main-content" data-pagefind-body={entry.data.pagefind ? "" : undefined} data-pagefind-ignore={!entry.data.pagefind ? "all" : undefined}>
        <div class="page-heading">
          <p class="eyebrow" data-pagefind-ignore>{group}</p>
          <h1 data-pagefind-meta="title">{entry.data.title}</h1>
          <p class="description">{entry.data.description}</p>
        </div>
        <div class="prose"><slot /></div>
        <footer class="article-footer" data-pagefind-ignore>
          <a class="edit-link" href={`${ecosystem.projects.docs.repository}/edit/main/apps/applio-docs/src/content/docs/${entry.id}.mdx`}>Edit this page on GitHub <Icon name="external-link" size={12} /></a>
          <nav class="pagination" aria-label="More documentation">
            {previous && <a href={previous.href}><small><Icon name="arrow-left" /> Previous</small><span>{previous.label}</span></a>}
            {next && <a href={next.href}><small>Next <Icon name="arrow-right" /></small><span>{next.label}</span></a>}
          </nav>
        </footer>
      </main>
      <aside class="toc" aria-label="On this page">
        {toc.length > 0 && <nav><h2>On this page</h2><ul>{toc.map(heading => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav>}
        <a class="toc-help" href={ecosystem.links.discord}>Need a hand?<br /><span>Join the community <Icon name="external-link" size={12} /></span></a>
      </aside>
    </div>
    <dialog id="docs-search" aria-labelledby="search-title">
      <div class="search-heading"><h2 id="search-title">Search documentation</h2><button type="button" data-close-search aria-label="Close search">Esc</button></div>
      <label for="search-input" class="sr-only">Search guides and reference</label>
      <input id="search-input" type="search" placeholder="What would you like to do?" autocomplete="off" />
      <p id="search-status" role="status">Search guides, workflows, and reference.</p>
      <ul id="search-results" aria-label="Search results"></ul>
    </dialog>
    <script src="../scripts/docs.ts"></script>
  </body>
</html>
