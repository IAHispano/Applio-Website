---
const pathname = Astro.url.pathname;

interface NavItem {
	label: string;
	href: string;
	external?: boolean;
}

const nav: NavItem[] = [
	{ label: "Features", href: "/#features" },
	{ label: "Documentation", href: "https://docs.applio.org", external: true },
	{ label: "Blog", href: "/blog" },
	{ label: "Community", href: "/community" },
];

function isActive(item: NavItem) {
	if (item.external) return false;
	const target = item.href.replace(/#.*$/, "");
	if (target === "/") return pathname === "/";
	return pathname === target || pathname.startsWith(`${target}/`);
}
---

<div class="sticky top-3 z-50 px-3 sm:px-4">
  <div
    class="mx-auto w-full max-w-4xl rounded-full bg-gradient-to-b from-white/25 via-white/10 to-white/5 p-px shadow-[0_8px_32px_rgba(0,0,0,0.45),0_1px_0_rgba(255,255,255,0.06)_inset]"
  >
    <header
      class="relative grid h-14 w-full grid-cols-[1fr_auto_1fr] items-center gap-4 rounded-full bg-[#191817]/75 px-4 backdrop-blur-2xl backdrop-saturate-150"
    >
    <a href="/" class="col-start-1 flex items-center gap-2.5 self-center justify-self-start" aria-label="Applio — back to home">
      <img
        src="/applio-logo.svg"
        alt=""
        class="h-6 w-auto"
        width="233"
        height="262"
      />
      <span class="text-lg font-bold tracking-tight text-white">Applio</span>
    </a>

    <nav
      class="col-start-2 hidden items-center justify-center gap-1 lg:flex"
      aria-label="Main navigation"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
            aria-current={isActive(item) ? "page" : undefined}
            class:list={[
              "rounded-full px-4 py-2 text-sm transition-colors duration-200",
              isActive(item)
                ? "bg-white/10 text-white"
                : "text-neutral-400 hover:bg-white/5 hover:text-white",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="col-start-3 flex items-center justify-end justify-self-end gap-2">
      <a
        href="https://github.com/IAHispano/Applio"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-2 rounded-full border border-white/10 bg-white/[0.07] px-4 py-2 text-sm text-neutral-300 transition-all duration-200 hover:border-white/25 hover:bg-white/[0.12] sm:flex"
        aria-label="Applio on GitHub"
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.04-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49.99.11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.94 0-1.31.47-2.39 1.24-3.23-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.56 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.92 1.23 3.23 0 4.61-2.8 5.63-5.48 5.93.43.37.81 1.1.81 2.22 0 1.6-.01 2.88-.01 3.27 0 .32.21.7.82.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"
          />
        </svg>
        <span class="hidden xl:inline">Star</span>
        <span
          id="github-stars"
          class="tabular-nums font-medium text-white"
          data-state="loading"
          >…</span
        >
      </a>

      <a
        href="https://docs.applio.org/getting-started/installation/"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden rounded-full bg-white px-4 py-2 text-sm font-medium text-black transition-all duration-200 hover:bg-neutral-200 sm:inline-flex"
      >
        Download
      </a>

      <details class="group lg:hidden">
        <summary
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-white/15 bg-white/5 text-white transition-all duration-200 [&::-webkit-details-marker]:hidden hover:bg-white/10"
          aria-label="Toggle navigation menu"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 6h16"></path>
            <path d="M4 12h16"></path>
            <path d="M4 18h16"></path>
          </svg>
        </summary>
        <div
          class="absolute inset-x-0 top-[calc(100%+8px)] z-50 mx-1 max-h-[70vh] overflow-y-auto rounded-2xl border border-white/10 bg-[#191817]/95 p-2 shadow-2xl shadow-black/50 backdrop-blur-2xl backdrop-saturate-150"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
                class="flex items-center justify-between rounded-xl px-4 py-3 text-sm text-neutral-200 transition-colors duration-200 hover:bg-white/10 hover:text-white"
              >
                {item.label}
                {item.external && <span class="text-neutral-500">↗</span>}
              </a>
            ))
          }
          <a
            href="/playground"
            class="flex items-center justify-between rounded-xl px-4 py-3 text-sm text-neutral-200 transition-colors duration-200 hover:bg-white/10 hover:text-white"
          >
            Playground
          </a>
          <a
            href="/search"
            class="flex items-center justify-between rounded-xl px-4 py-3 text-sm text-neutral-200 transition-colors duration-200 hover:bg-white/10 hover:text-white"
          >
            Search models
          </a>
          <a
            href="https://github.com/IAHispano/Applio"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-1 flex items-center justify-center gap-2 rounded-xl bg-white/10 px-4 py-3 text-sm font-medium text-white transition-colors duration-200 hover:bg-white/20"
          >
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="currentColor"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.04-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49.99.11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.94 0-1.31.47-2.39 1.24-3.23-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.56 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.92 1.23 3.23 0 4.61-2.8 5.63-5.48 5.93.43.37.81 1.1.81 2.22 0 1.6-.01 2.88-.01 3.27 0 .32.21.7.82.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"
              />
            </svg>
            Star us on GitHub
          </a>
        </div>
      </details>
    </div>
  </header>
</div>

<script>
	function formatStars(n: number) {
		return new Intl.NumberFormat("en", {
			notation: "compact",
			maximumFractionDigits: 1,
		}).format(n);
	}

	async function loadGitHubStats() {
		const el = document.getElementById("github-stars") as HTMLSpanElement | null;
		if (!el) return;

		try {
			const res = await fetch("https://api.github.com/repos/IAHispano/Applio");
			if (!res.ok) throw new Error("GitHub API request failed");

			const repo = (await res.json()) as { stargazers_count?: number };
			if (typeof repo.stargazers_count !== "number") throw new Error("Missing data");

			el.textContent = formatStars(repo.stargazers_count);
			el.dataset.state = "loaded";
		} catch {
			el.dataset.state = "error";
			el.classList.add("hidden");
		}
	}

	document.addEventListener("astro:page-load", loadGitHubStats);
</script>