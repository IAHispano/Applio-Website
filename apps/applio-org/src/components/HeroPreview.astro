---
---

<div class="relative mx-auto mt-14 w-full max-w-2xl animate-fade-in">
  <div
    class="absolute -inset-1 rounded-[2rem] bg-gradient-to-b from-white/10 via-white/5 to-transparent blur-2xl"
    aria-hidden="true"
  ></div>

  <div
    class="relative overflow-hidden rounded-3xl border border-white/10 bg-[#151414]/80 p-5 shadow-2xl shadow-black/50 backdrop-blur-2xl sm:p-6"
  >
    <div
      class="pointer-events-none absolute inset-x-10 top-0 h-px bg-gradient-to-r from-transparent via-white/40 to-transparent"
      aria-hidden="true"
    ></div>
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-white"></span>
      </div>
      <span class="text-xs text-neutral-500">Applio Voice Lab</span>
      <div class="flex items-center gap-1.5">
        <span class="flex h-3 items-end gap-[2px]" aria-hidden="true">
          <span class="eq-bar w-[3px] rounded-full bg-white" style="height: 8px"></span>
          <span class="eq-bar w-[3px] rounded-full bg-white" style="height: 4px"></span>
          <span class="eq-bar w-[3px] rounded-full bg-white" style="height: 10px"></span>
          <span class="eq-bar w-[3px] rounded-full bg-white" style="height: 6px"></span>
        </span>
        <span class="text-xs text-neutral-400">Playing</span>
      </div>
    </div>

    <div class="mt-6 space-y-5">
      <div>
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium uppercase tracking-widest text-neutral-500">
            Source voice
          </span>
          <span class="flex items-center gap-2">
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-neutral-300">
              Acat &middot; RVC v2
            </span>
            <span
              id="source-clock"
              class="tabular-nums text-xs text-neutral-500"
              >00:00</span
            >
          </span>
        </div>
        <p class="mt-2 text-left text-xs text-neutral-500">
          The voice you provide — for example a clip of Acat&apos;s voice.
        </p>
        <div
          id="source-wave"
          class="mt-3 h-11 w-full [filter:drop-shadow(0_0_10px_rgba(255,255,255,0.15))]"
        ></div>
      </div>

      <div>
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium uppercase tracking-widest text-neutral-500">
            Converted voice
          </span>
          <span class="flex items-center gap-2 text-xs text-white">
            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            <span id="output-clock" class="tabular-nums text-neutral-500">00:00</span>
          </span>
        </div>
        <div
          id="output-wave"
          class="mt-3 h-11 w-full [filter:drop-shadow(0_0_12px_rgba(255,255,255,0.35))]"
        ></div>
        <p class="mt-2 text-left text-xs text-neutral-500">
          The result: Applio’s output voice. This preview is
          silent — try it in the playground to hear it.
        </p>
      </div>
    </div>

    <div class="mt-6 flex items-center justify-between gap-3">
      <div class="flex flex-wrap gap-2">
        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs text-neutral-300">
          Pitch 12
        </span>
        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs text-neutral-300">
          Index rate 8
        </span>
        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs text-neutral-300">
          Protect 0.5
        </span>
      </div>
      <a
        href="/playground"
        class="inline-flex shrink-0 items-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-black transition-transform duration-200 hover:scale-105"
      >
        Convert
        <svg
          class="h-3.5 w-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>

  <div
    class="absolute -left-3 top-1/3 hidden -translate-x-full items-center gap-2 rounded-full border border-white/10 bg-[#151414]/80 px-4 py-2 text-xs text-neutral-300 shadow-xl backdrop-blur-xl sm:flex"
  >
    <svg class="h-3.5 w-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path>
    </svg>
    Real-time &lt;120ms
  </div>

  <div
    class="absolute -right-3 bottom-6 hidden translate-x-full items-center gap-2 rounded-full border border-white/10 bg-[#151414]/80 px-3 py-2 text-xs text-neutral-300 shadow-xl backdrop-blur-xl sm:flex"
  >
    <svg class="h-3.5 w-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 12h2l2-7 3 14 3-11 2 4h6"></path>
    </svg>
    Zero telemetry
  </div>
</div>

<style>
  .eq-bar {
    animation: eq 0.9s ease-in-out infinite alternate;
    transform-origin: bottom;
  }
  .eq-bar:nth-child(2) {
    animation-delay: 0.15s;
  }
  .eq-bar:nth-child(3) {
    animation-delay: 0.3s;
  }
  .eq-bar:nth-child(4) {
    animation-delay: 0.45s;
  }

  @keyframes eq {
    from {
      transform: scaleY(0.35);
    }
    to {
      transform: scaleY(1);
    }
  }
</style>

<script>
	const WAVE_IDS = ["source-wave", "output-wave"] as const;
	const CLOCK_IDS = ["source-clock", "output-clock"] as const;

	function makePeaks(size = 72, seed = 1) {
		const peaks = new Float32Array(size);
		for (let i = 0; i < size; i++) {
			const x = i / (size - 1);
			const envelope =
				Math.sin((x + 0.25) * Math.PI) * 0.6 + 0.15;
			const wobble =
				Math.sin(2 * Math.PI * 3.1 * x + seed * 2.4) * 0.5 +
				Math.sin(2 * Math.PI * 7.3 * x + seed * 1.1) * 0.5;
			const attack = Math.min(1, x * 14);
			const release = Math.min(1, (1 - x) * 10);
			peaks[i] = Math.max(0.06, envelope * (0.35 + wobble) * attack * release);
		}
		return peaks;
	}

	async function init() {
		const containers = WAVE_IDS.map((id) =>
			document.getElementById(id),
		).filter(Boolean) as HTMLElement[];
		if (containers.length !== WAVE_IDS.length) return;

		let WaveSurfer: any;
		try {
			const win = window as any;
			if (win.WaveSurfer) {
				WaveSurfer = win.WaveSurfer;
			} else {
				WaveSurfer = await new Promise((resolve, reject) => {
					const s = document.createElement("script");
					s.src = "https://unpkg.com/wavesurfer.js@7";
					s.async = true;
					s.onload = () => resolve(win.WaveSurfer);
					s.onerror = () => reject(new Error("wavesurfer failed to load"));
					document.head.appendChild(s);
				});
			}
		} catch {
			containers.forEach((el) => (el.style.display = "none"));
			CLOCK_IDS.forEach((id) => {
				const el = document.getElementById(id);
				if (el) el.style.display = "none";
			});
			return;
		}

		const duration = 4;
		const common = {
			peaks: makePeaks(96, 0.4),
			duration,
			barWidth: 2.75,
			barGap: 1.75,
			barRadius: 3,
			height: 44,
			normalize: true,
			interaction: false,
			dragToSeek: false,
			showCursor: true,
			cursorWidth: 2,
			hideScrollbar: true,
			fillParent: true,
			
		} as any;

		const source = WaveSurfer.create({
			container: containers[0],
			waveColor: "rgba(255,255,255,0.25)",
			progressColor: "rgba(255,255,255,0.5)",
			cursorColor: "rgba(255,255,255,0.4)",
			...common,
		});
		const output = WaveSurfer.create({
			container: containers[1],
			waveColor: "rgba(255,255,255,0.8)",
			progressColor: "#ffffff",
			cursorColor: "rgba(255,255,255,0.95)",
			...common,
		});

		const ready = () =>
			Promise.all([
				new Promise((r) => {
					source.once("ready", r);
					source.once("error", r);
				}),
				new Promise((r) => {
					output.once("ready", r);
					output.once("error", r);
				}),
			]);

		const clocks = CLOCK_IDS.map((id) => document.getElementById(id));
		const fmt = (t: number) => {
			const s = Math.floor(t);
			const ms = Math.floor((t - s) * 10);
			return `${s.toString().padStart(2, "0")}:${ms}0`;
		};

		await ready();

		const reduced = window.matchMedia("(prefers-reduced-motion: reduce)")
			.matches;
		if (reduced) return;

		let t = 0;
		let playing = false;
		const tick = () => {
			t += 1 / 30;
			if (t >= duration) t = 0;
			source.setTime(t);
			output.setTime((t + 1.2) % duration);
			clocks[0].textContent = fmt(t);
			clocks[1].textContent = fmt((t + 1.2) % duration);
		};

		const start = () => {
			if (playing || reduced) return;
			playing = true;
			setInterval(tick, 1000 / 30);
		};

		const io = new IntersectionObserver(
			(entries) => {
				if (entries.some((e) => e.isIntersecting)) start();
			},
			{ threshold: 0.2 },
		);
		io.observe(containers[0].parentElement as Element);
	}

	document.addEventListener("astro:page-load", init);
</script>