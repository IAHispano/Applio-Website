---
import BackLink from "../components/BackLink.astro";
import GlowBackground from "../components/GlowBackground.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <GlowBackground />

  <div
    class="relative flex flex-col items-center w-full min-h-[100dvh] justify-center px-6 py-16 text-center"
  >
    <p class="text-8xl md:text-[150px] font-bold text-white/20 select-none leading-none animate-fade-in">
      404
    </p>
    <h1 class="text-4xl font-bold text-white mt-6 animate-fade-in">
      Page not found
    </h1>
    <p class="text-neutral-400 mt-4 mb-10 max-w-md animate-fade-in">
      The page you're looking for doesn't exist or has been moved to another
      location.
    </p>

    <div class="flex flex-wrap gap-4 justify-center items-center animate-fade-in">
      <a
        href="/"
        class="px-8 py-3 bg-white text-black font-medium rounded-full hover:bg-neutral-200 transition-all duration-300"
      >
        Back to home
      </a>
      <a
        href="https://docs.applio.org"
        target="_blank"
        class="px-8 py-3 bg-white/10 backdrop-blur-sm text-white font-medium rounded-full hover:bg-white/20 transition-all duration-300"
      >
        Documentation
      </a>
      <a
        href="/playground"
        class="px-8 py-3 bg-white/10 backdrop-blur-sm text-white font-medium rounded-full hover:bg-white/20 transition-all duration-300"
      >
        Playground
      </a>
      <a
        href="/discord"
        class="px-8 py-3 bg-white/10 backdrop-blur-sm text-white font-medium rounded-full hover:bg-white/20 transition-all duration-300"
      >
        Discord
      </a>
    </div>
  </div>
</Layout>