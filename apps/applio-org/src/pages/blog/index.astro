---
import Layout from "../../layouts/Layout.astro";

interface BlogPost {
	frontmatter: {
		title: string;
		description: string;
		date: string;
		tag: string;
	};
	url: string;
}

const posts = import.meta.glob("./*.astro", { eager: true });

const sortedPosts = Object.entries(posts)
	.filter(([path]) => path !== "./index.astro")
	.map(([path, module]) => {
		const { frontmatter } = module as BlogPost;
		return {
			frontmatter,
			url: path.replace("./", "/blog/").replace(".astro", ""),
		};
	})
	.sort(
		(a, b) =>
			new Date(b.frontmatter.date).getTime() -
			new Date(a.frontmatter.date).getTime(),
	);
---

<Layout>
  <div class="flex flex-col items-start justify-center max-w-4xl mx-auto px-6 md:px-12 pt-24 pb-24 text-base w-full">
    <span
      class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs text-neutral-300 backdrop-blur-sm"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
      Blog
    </span>

    <h1 class="mt-6 text-4xl font-bold text-white tracking-tight mb-8">News &amp; updates</h1>

    <div class="grid gap-6 w-full">
      {
        sortedPosts.map((post) => (
          <a
            href={post.url}
            class="group block p-8 border border-white/10 bg-white/5 backdrop-blur-sm rounded-2xl hover:bg-white/10 hover:border-white/20 transition-all duration-300"
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2 class="text-2xl font-semibold text-white mb-3">
                  {post.frontmatter.title}
                </h2>
                <p class="text-neutral-300 mb-4">
                  {post.frontmatter.description}
                </p>
                <div class="flex items-center gap-3">
                  <span class="px-4 py-1.5 bg-white/10 backdrop-blur-sm text-white rounded-full text-sm">
                    {post.frontmatter.tag}
                  </span>
                  <span class="text-neutral-400 text-sm">
                    {
                      new Date(post.frontmatter.date).toLocaleDateString(
                        "en-US",
                        {
                          year: "numeric",
                          month: "long",
                          day: "numeric",
                        },
                      )
                    }
                  </span>
                </div>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
