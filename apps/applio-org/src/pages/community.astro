---
import GlowBackground from "../components/GlowBackground.astro";
import Layout from "../layouts/Layout.astro";

interface CommunityCard {
	title: string;
	description: string;
	href: string;
	external?: boolean;
	cta: string;
	icon: "discord" | "github" | "blog" | "support" | "issues";
}

const cards: CommunityCard[] = [
	{
		title: "Discord server",
		description:
			"Chat with thousands of users, share creations, ask questions, and get help in real time.",
		href: "/discord",
		cta: "Join the server",
		icon: "discord",
	},
	{
		title: "GitHub repository",
		description:
			"Browse the source code, follow development, star the project, and keep an eye on releases.",
		href: "https://github.com/IAHispano/Applio",
		external: true,
		cta: "Open repository",
		icon: "github",
	},
	{
		title: "Issues & feature requests",
		description:
			"Found a bug or have an idea? Report it so the maintainers and contributors can take a look.",
		href: "https://github.com/IAHispano/Applio/issues",
		external: true,
		cta: "Open issues",
		icon: "issues",
	},
	{
		title: "Blog & announcements",
		description:
			"Release notes, product updates, and news about the Applio ecosystem — straight from the team.",
		href: "/blog",
		cta: "Read the blog",
		icon: "blog",
	},
	{
		title: "Support the project",
		description:
			"Applio is free and open source, maintained entirely by the community. Donations help it stay that way.",
		href: "/donate",
		cta: "Support on Ko-fi",
		icon: "support",
	},
];
---

<Layout>
  <GlowBackground />

  <div
    class="relative flex flex-col items-start max-w-4xl mx-auto px-6 md:px-12 pt-24 pb-24 text-sm animate-fade-in w-full"
  >
    <span
      class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs text-neutral-300 backdrop-blur-sm"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
      Community
    </span>

    <h1 class="mt-6 text-4xl md:text-5xl font-bold text-white tracking-tight">
      Join the Applio community
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-neutral-300">
      Applio is built by and for its community. Whether you're here to learn,
      share your creations, or contribute code, there's a place for you.
    </p>

    <div class="mt-12 grid gap-6 md:grid-cols-2 w-full">
      {
        cards.map((card) => (
          <a
            href={card.href}
            target={card.external ? "_blank" : undefined}
            rel={card.external ? "noopener noreferrer" : undefined}
            class="group block p-8 bg-white/5 border border-white/10 backdrop-blur-sm rounded-2xl hover:bg-white/10 hover:border-white/20 transition-all duration-300"
          >
            <div class="flex items-center justify-between">
              <span
                class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-white"
              >
                {
                  card.icon === "discord" && (
                    <svg
                      class="w-5 h-5"
                      viewBox="0 0 30 23"
                      fill="currentColor"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M25.1716 1.88417C23.2874 1.00583 21.2474 0.368333 19.1224 0C19.085 0.000532248 19.0494 0.0158083 19.0232 0.0425003C18.7682 0.51 18.4707 1.11917 18.2724 1.58667C16.0185 1.24688 13.7263 1.24688 11.4724 1.58667C11.2741 1.105 10.9766 0.51 10.7074 0.0425003C10.6932 0.014167 10.6507 0 10.6082 0C8.48323 0.368333 6.4574 1.00583 4.55907 1.88417C4.5449 1.88417 4.53073 1.89833 4.51657 1.9125C0.663233 7.67833 -0.399268 13.2883 0.124899 18.8417C0.124899 18.87 0.139066 18.8983 0.167399 18.9125C2.7174 20.7825 5.16823 21.9158 7.59073 22.6667C7.63323 22.6808 7.67573 22.6667 7.6899 22.6383C8.25657 21.8592 8.76657 21.0375 9.20573 20.1733C9.23407 20.1167 9.20573 20.06 9.14907 20.0458C8.34157 19.7342 7.57657 19.3658 6.82573 18.9408C6.76907 18.9125 6.76907 18.8275 6.81157 18.785C6.9674 18.6717 7.12323 18.5442 7.27907 18.4308C7.3074 18.4025 7.3499 18.4025 7.37823 18.4167C12.2516 20.6408 17.5074 20.6408 22.3241 18.4167C22.3524 18.4025 22.3949 18.4025 22.4232 18.4308C22.5791 18.5583 22.7349 18.6717 22.8907 18.7992C22.9474 18.8417 22.9474 18.9267 22.8766 18.955C22.1399 19.3942 21.3607 19.7483 20.5532 20.06C20.4966 20.0742 20.4824 20.145 20.4966 20.1875C20.9499 21.0517 21.4599 21.8733 22.0124 22.6525C22.0549 22.6667 22.0974 22.6808 22.1399 22.6667C24.5766 21.9158 27.0274 20.7825 29.5774 18.9125C29.6057 18.8983 29.6199 18.87 29.6199 18.8417C30.2432 12.4242 28.5857 6.85667 25.2282 1.9125C25.2141 1.89833 25.1999 1.88417 25.1716 1.88417ZM9.9424 15.4558C8.48323 15.4558 7.2649 14.11 7.2649 12.4525C7.2649 10.795 8.4549 9.44917 9.9424 9.44917C11.4441 9.44917 12.6341 10.8092 12.6199 12.4525C12.6199 14.11 11.4299 15.4558 9.9424 15.4558ZM19.8166 15.4558C18.3574 15.4558 17.1391 14.11 17.1391 12.4525C17.1391 10.795 18.3291 9.44917 19.8166 9.44917C21.3182 9.44917 22.5082 10.8092 22.4941 12.4525C22.4941 14.11 21.3182 15.4558 19.8166 15.4558Z"
                      />
                    </svg>
                  )
                }
                {
                  card.icon === "github" && (
                    <svg
                      class="w-5 h-5"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.04-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49.99.11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.94 0-1.31.47-2.39 1.24-3.23-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.56 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.92 1.23 3.23 0 4.61-2.8 5.63-5.48 5.93.43.37.81 1.1.81 2.22 0 1.6-.01 2.88-.01 3.27 0 .32.21.7.82.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"
                      />
                    </svg>
                  )
                }
                {
                  card.icon === "issues" && (
                    <svg
                      class="w-5 h-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="12" cy="12" r="10"></circle>
                      <line x1="12" y1="8" x2="12" y2="12"></line>
                      <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                  )
                }
                {
                  card.icon === "blog" && (
                    <svg
                      class="w-5 h-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"></path>
                      <path d="M18 14h-8"></path>
                      <path d="M15 18h-5"></path>
                      <path d="M10 6h8v4h-8V6Z"></path>
                    </svg>
                  )
                }
                {
                  card.icon === "support" && (
                    <svg
                      class="w-5 h-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
                    </svg>
                  )
                }
              </span>
              <span class="text-white/30 group-hover:text-white/60 transition-colors duration-300">→</span>
            </div>
            <h3 class="mt-6 text-xl font-semibold text-white">{card.title}</h3>
            <p class="mt-2 text-neutral-300 text-sm leading-relaxed">
              {card.description}
            </p>
            <span
              class="mt-5 inline-flex items-center gap-2 text-sm text-white/70 transition-all duration-300 group-hover:gap-3 group-hover:text-white"
            >
              {card.cta}
              <svg
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </span>
          </a>
        ))
      }
    </div>

    <div
      class="mt-12 w-full p-8 bg-white/5 border border-white/10 backdrop-blur-sm rounded-2xl"
    >
      <h2 class="text-2xl font-semibold text-white">Ways to contribute</h2>
      <p class="mt-3 text-neutral-300 text-sm leading-relaxed max-w-3xl">
        You don't need to be a developer to help. Reporting bugs, improving the
        documentation, translating, testing releases, and helping others in the
        Discord server all make a real difference.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="https://docs.applio.org/getting-started/report-error/"
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 text-sm rounded-full bg-white text-black font-medium hover:bg-neutral-200 transition-all duration-200"
        >
          Report a bug
        </a>
        <a
          href="https://github.com/IAHispano/Applio-Website"
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 text-sm rounded-full bg-white/10 hover:bg-white/20 transition-all duration-200"
        >
          Improve this website
        </a>
        <a
          href="https://github.com/IAHispano/Applio-Website/edit/main/apps/applio-docs/"
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 text-sm rounded-full bg-white/10 hover:bg-white/20 transition-all duration-200"
        >
          Improve the docs
        </a>
        <a
          href="https://github.com/IAHispano/Applio/blob/main/TERMS_OF_USE.md"
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 text-sm rounded-full bg-white/10 hover:bg-white/20 transition-all duration-200"
        >
          Code of conduct
        </a>
      </div>
    </div>
  </div>
</Layout>