            <a
              href="https://huggingface.co/IAHispano/Applio"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between px-3.5 py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs text-white transition-colors"
            >
