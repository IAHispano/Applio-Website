<script>
  function setupDownloadPage() {
    // 1. Tab Switching (Desktop App vs WebUI Gradio)
    const tabDesktop = document.getElementById("tab-btn-desktop");
    const tabGradio = document.getElementById("tab-btn-gradio");
    const badgeTabDesktop = document.getElementById("badge-tab-desktop");
    const badgeTabGradio = document.getElementById("badge-tab-gradio");
    const viewDesktop = document.getElementById("view-desktop");
    const viewGradio = document.getElementById("view-gradio");
    const subtitle = document.getElementById("page-subtitle");

    function setActiveTab(type: "desktop" | "gradio", updateHistory = true) {
      if (type === "desktop") {
        viewDesktop?.classList.remove("hidden");
        viewGradio?.classList.add("hidden");

        tabDesktop?.classList.remove("text-neutral-400", "hover:text-white");
        tabDesktop?.classList.add("bg-white", "text-black", "shadow-md");
        tabDesktop?.setAttribute("aria-selected", "true");

        badgeTabDesktop?.classList.remove("bg-white/10", "text-neutral-300");
        badgeTabDesktop?.classList.add("bg-black/10", "text-black");

        tabGradio?.classList.remove("bg-white", "text-black", "shadow-md");
        tabGradio?.classList.add("text-neutral-400", "hover:text-white");
        tabGradio?.setAttribute("aria-selected", "false");

        badgeTabGradio?.classList.remove("bg-black/10", "text-black");
        badgeTabGradio?.classList.add("bg-white/10", "text-neutral-300");

        if (subtitle) {
          subtitle.textContent = "Select your operating system to start downloading the modern standalone desktop studio.";
        }

        if (updateHistory && window.location.hash !== "#app" && window.location.hash !== "") {
          history.replaceState(null, "", window.location.pathname);
        }
      } else {
        viewDesktop?.classList.add("hidden");
        viewGradio?.classList.remove("hidden");

        tabGradio?.classList.remove("text-neutral-400", "hover:text-white");
        tabGradio?.classList.add("bg-white", "text-black", "shadow-md");
        tabGradio?.setAttribute("aria-selected", "true");

        badgeTabGradio?.classList.remove("bg-white/10", "text-neutral-300");
        badgeTabGradio?.classList.add("bg-black/10", "text-black");

        tabDesktop?.classList.remove("bg-white", "text-black", "shadow-md");
        tabDesktop?.classList.add("text-neutral-400", "hover:text-white");
        tabDesktop?.setAttribute("aria-selected", "false");

        badgeTabDesktop?.classList.remove("bg-black/10", "text-black");
        badgeTabDesktop?.classList.add("bg-white/10", "text-neutral-300");

        if (subtitle) {
          subtitle.textContent = "Classic browser-based research interface with full CLI tools, web interface, and hardware acceleration.";
        }

        if (updateHistory && window.location.hash !== "#gradio") {
          history.replaceState(null, "", "#gradio");
        }
      }
    }

    tabDesktop?.addEventListener("click", () => setActiveTab("desktop"));
    tabGradio?.addEventListener("click", () => setActiveTab("gradio"));

    // Check initial tab from URL hash or query param (?tab=gradio or #gradio)
    const hash = window.location.hash.toLowerCase();
    const urlParams = new URLSearchParams(window.location.search);
    if (hash === "#gradio" || hash === "#webui" || urlParams.get("tab") === "gradio") {
      setActiveTab("gradio", false);
    } else {
      setActiveTab("desktop", false);
    }

    // 2. Detect operating system for Desktop view
    const ua = window.navigator.userAgent;
    let detectedOS = "Windows"; // Default fallback
    if (ua.indexOf("Win") !== -1) detectedOS = "Windows";
    else if (ua.indexOf("Mac") !== -1) detectedOS = "macOS";
    else if (ua.indexOf("Linux") !== -1) detectedOS = "Linux";

    // Highlight and reorder recommended platform card
    const cardWindows = document.getElementById("card-windows");
    const cardMac = document.getElementById("card-mac");
    const cardLinux = document.getElementById("card-linux");
    const cards = [cardWindows, cardMac, cardLinux].filter(Boolean) as HTMLElement[];

    const badgeMap: Record<string, HTMLElement | null> = {
      Windows: document.getElementById("badge-windows"),
      macOS: document.getElementById("badge-mac"),
      Linux: document.getElementById("badge-linux"),
    };

    const btnMap: Record<string, HTMLElement | null> = {
      Windows: document.getElementById("btn-windows"),
      macOS: document.getElementById("toggle-mac-dropdown"),
      Linux: document.getElementById("toggle-linux-dropdown"),
    };

    cards.forEach((card) => {
      const platform = card.dataset.platform;
      const isDetected = platform === detectedOS;
      const badge = badgeMap[platform || ""];
      const btn = btnMap[platform || ""];

      if (isDetected) {
        card.classList.remove("bg-white/5", "border-white/10");
        card.classList.add("bg-white/10", "border-white/25", "shadow-white/5");
        badge?.classList.remove("hidden");

        if (btn) {
          btn.classList.remove("bg-white/10", "text-white");
          btn.classList.add("bg-white", "text-black", "hover:bg-neutral-200");
        }
      } else {
        card.classList.add("bg-white/5", "border-white/10");
        card.classList.remove("bg-white/10", "border-white/25", "shadow-white/5");
        badge?.classList.add("hidden");

        if (btn) {
          btn.classList.add("bg-white/10", "text-white");
          btn.classList.remove("bg-white", "text-black", "hover:bg-neutral-200");
        }
      }
    });

    // Reorder cards so the detected card is placed prominently in the center on desktop
    const container = document.getElementById("cards-container");
    if (container && detectedOS) {
      const detectedCard = cards.find((c) => c.dataset.platform === detectedOS);
      const otherCards = cards.filter((c) => c.dataset.platform !== detectedOS);
      if (detectedCard && otherCards.length === 2) {
        container.innerHTML = "";
        container.appendChild(otherCards[0]);
        container.appendChild(detectedCard);
        container.appendChild(otherCards[1]);
      }
    }

    // Show macOS Gatekeeper notice ONLY if macOS is detected
    const macNotice = document.getElementById("mac-notice");
    if (macNotice) {
      if (detectedOS === "macOS") {
        macNotice.classList.remove("hidden");
      } else {
        macNotice.classList.add("hidden");
      }
    }

    // 3. Dropdowns handling (macOS & Linux)
    const setupDropdown = (
      toggleBtnId: string,
      menuId: string,
      chevronId: string
    ) => {
      const btn = document.getElementById(toggleBtnId);
      const menu = document.getElementById(menuId);
      const chevron = document.getElementById(chevronId);

      if (!btn || !menu) return;

      const toggleMenu = (e?: Event) => {
        if (e) e.stopPropagation();
        const isOpen = !menu.classList.contains("hidden");
        if (isOpen) {
          menu.classList.add("hidden");
          chevron?.classList.remove("rotate-180");
          btn.setAttribute("aria-expanded", "false");
        } else {
          document.querySelectorAll("[id^='menu-']").forEach((m) => m.classList.add("hidden"));
          document.querySelectorAll("[id$='-chevron']").forEach((c) => c.classList.remove("rotate-180"));
          menu.classList.remove("hidden");
          chevron?.classList.add("rotate-180");
          btn.setAttribute("aria-expanded", "true");
        }
      };

      btn.addEventListener("click", toggleMenu);
    };

    setupDropdown("toggle-mac-dropdown", "menu-mac", "mac-chevron");
    setupDropdown("toggle-linux-dropdown", "menu-linux", "linux-chevron");

    // Close dropdowns on outside click or escape
    const handleDocumentClick = (e: MouseEvent) => {
      const target = e.target as HTMLElement;
      if (!target.closest("#card-mac") && !target.closest("#card-linux")) {
        document.querySelectorAll("[id^='menu-']").forEach((m) => m.classList.add("hidden"));
        document.querySelectorAll("[id$='-chevron']").forEach((c) => c.classList.remove("rotate-180"));
      }
    };

    const handleKeydown = (e: KeyboardEvent) => {
      if (e.key === "Escape") {
        document.querySelectorAll("[id^='menu-']").forEach((m) => m.classList.add("hidden"));
        document.querySelectorAll("[id$='-chevron']").forEach((c) => c.classList.remove("rotate-180"));
      }
    };

    document.addEventListener("click", handleDocumentClick);
    document.addEventListener("keydown", handleKeydown);

    // 4. Copy helper for macOS xattr
    const copyXattrBtn = document.getElementById("copy-xattr-btn");
    copyXattrBtn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText("xattr -cr /Applications/Applio.app");
        copyXattrBtn.textContent = "Copied!";
        setTimeout(() => {
          copyXattrBtn.textContent = "Copy";
        }, 2000);
      } catch (err) {
        console.error("Failed to copy", err);
      }
    });

    // 5. Copy helper for Git commands in Gradio card
    const copyGitBtn = document.getElementById("copy-git-btn");
    copyGitBtn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(
          "git clone https://github.com/IAHispano/Applio.git\ncd Applio\nrun-install.bat"
        );
        copyGitBtn.textContent = "Copied!";
        setTimeout(() => {
          copyGitBtn.textContent = "Copy";
        }, 2000);
      } catch (err) {
        console.error("Failed to copy", err);
      }
    });

    // 6. Fetch latest release dynamically from GitHub API for Desktop App
    fetch("https://api.github.com/repos/IAHispano/Applio-App/releases/latest")
      .then((res) => {
        if (!res.ok) throw new Error("GitHub API error");
        return res.json();
      })
      .then((release) => {
        if (!release || !release.assets) return;

        const tagName = release.tag_name || release.name;
        const badge = document.getElementById("release-version-badge");
        if (badge && tagName) {
          badge.textContent = `Desktop ${tagName} • Gradio v3.6.5`;
        }

        const assets: Array<{ name: string; browser_download_url: string }> = release.assets;

        // Windows setup .exe
        const winAsset = assets.find(
          (a) => a.name.endsWith("-Windows-Setup.exe") || a.name.endsWith(".exe")
        );
        if (winAsset) {
          const btn = document.getElementById("btn-windows") as HTMLAnchorElement | null;
          if (btn) btn.href = winAsset.browser_download_url;
        }

        // Mac ARM dmg
        const macArmDmg = assets.find((a) => a.name.includes("macOS-arm64.dmg"));
        if (macArmDmg) {
          const link = document.getElementById("link-mac-arm-dmg") as HTMLAnchorElement | null;
          if (link) link.href = macArmDmg.browser_download_url;
        }

        // Mac Intel dmg
        const macIntelDmg = assets.find((a) => a.name.includes("macOS-x64.dmg"));
        if (macIntelDmg) {
          const link = document.getElementById("link-mac-intel-dmg") as HTMLAnchorElement | null;
          if (link) link.href = macIntelDmg.browser_download_url;
        }

        // Mac ARM zip
        const macArmZip = assets.find((a) => a.name.includes("macOS-arm64.zip"));
        if (macArmZip) {
          const link = document.getElementById("link-mac-arm-zip") as HTMLAnchorElement | null;
          if (link) link.href = macArmZip.browser_download_url;
        }

        // Mac Intel zip
        const macIntelZip = assets.find((a) => a.name.includes("macOS-x64.zip"));
        if (macIntelZip) {
          const link = document.getElementById("link-mac-intel-zip") as HTMLAnchorElement | null;
          if (link) link.href = macIntelZip.browser_download_url;
        }

        // Linux AppImage
        const linuxAppImage = assets.find((a) => a.name.endsWith(".AppImage"));
        if (linuxAppImage) {
          const link = document.getElementById("link-linux-appimage") as HTMLAnchorElement | null;
          if (link) link.href = linuxAppImage.browser_download_url;
        }

        // Linux deb
        const linuxDeb = assets.find((a) => a.name.endsWith(".deb"));
        if (linuxDeb) {
          const link = document.getElementById("link-linux-deb") as HTMLAnchorElement | null;
          if (link) link.href = linuxDeb.browser_download_url;
        }
      })
      .catch((err) => {
        // Static fallbacks remain active
        console.log("Using static release assets", err);
      });
  }

  document.addEventListener("astro:page-load", setupDownloadPage);
</script>
