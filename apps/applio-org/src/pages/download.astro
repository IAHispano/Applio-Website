---
import GlowBackground from "../components/GlowBackground.astro";
import Layout from "../layouts/Layout.astro";

// Default fallback release version & links based on latest GitHub releases
const defaultVersion = "v0.1.2";
const gradioVersion = "v3.6.5";
const releasesUrl = "https://github.com/IAHispano/Applio-App/releases";
const gradioReleasesUrl = "https://github.com/IAHispano/Applio/releases/tag/3.6.5";

const staticDownloads = {
	windows:
		"https://github.com/IAHispano/Applio-App/releases/download/v0.1.2/Applio-0.1.2-Windows-Setup.exe",
	macArmDmg:
		"https://github.com/IAHispano/Applio-App/releases/download/v0.1.2/Applio-0.1.2-macOS-arm64.dmg",
	macIntelDmg:
		"https://github.com/IAHispano/Applio-App/releases/download/v0.1.2/Applio-0.1.2-macOS-x64.dmg",
	macArmZip:
		"https://github.com/IAHispano/Applio-App/releases/download/v0.1.2/Applio-0.1.2-macOS-arm64.zip",
	macIntelZip:
		"https://github.com/IAHispano/Applio-App/releases/download/v0.1.2/Applio-0.1.2-macOS-x64.zip",
	linuxAppImage:
		"https://github.com/IAHispano/Applio-App/releases/download/v0.1.2/Applio-0.1.2-Linux.AppImage",
	linuxDeb:
		"https://github.com/IAHispano/Applio-App/releases/download/v0.1.2/Applio-0.1.2-Linux.deb",
	gradioWindowsZip:
		"https://huggingface.co/IAHispano/Applio/resolve/main/Compiled/Windows/ApplioV3.6.5.zip",
};
---

<Layout
  title="Download Applio — Desktop App & Gradio WebUI"
  description="Download Applio for Windows, macOS, and Linux. Choose between the modern Applio Desktop application or the classic Gradio WebUI."
>
  <GlowBackground />

  <main class="relative flex flex-col items-center justify-center min-h-[calc(100dvh-4.5rem)] px-4 sm:px-8 py-16 sm:py-20">
    <!-- Header section -->
    <div class="text-center max-w-3xl mx-auto mb-8 sm:mb-10 animate-fade-in">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs text-neutral-300 backdrop-blur mb-5">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span id="release-version-badge">Desktop {defaultVersion} • Gradio {gradioVersion}</span>
        <span class="text-white/20">•</span>
        <a href="https://github.com/IAHispano/Applio" target="_blank" rel="noopener noreferrer" class="text-white/70 hover:text-white transition-colors">
          Open Source
        </a>
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-semibold text-white tracking-tighter mb-4 sm:mb-6 text-balance">
        Download Applio
      </h1>
      <p id="page-subtitle" class="text-base sm:text-lg text-white/70 leading-relaxed max-w-xl mx-auto px-4">
        Choose between the modern standalone Desktop application or the classic Gradio WebUI.
      </p>
    </div>

    <!-- Mode Switcher Tabs: Desktop App (default) vs WebUI Gradio (classic) -->
    <div
      role="tablist"
      aria-label="Applio version selection"
      class="inline-flex items-center justify-center p-1 rounded-full bg-white/5 border border-white/10 backdrop-blur-md mb-10 shadow-lg max-w-full"
    >
      <button
        type="button"
        id="tab-btn-desktop"
        role="tab"
        aria-selected="true"
        aria-controls="view-desktop"
        class="inline-flex items-center justify-center gap-2 py-2 px-3.5 sm:px-5 rounded-full text-xs sm:text-sm font-semibold whitespace-nowrap transition-all duration-200 bg-white text-black shadow-md cursor-pointer shrink-0"
      >
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
          <line x1="8" y1="21" x2="16" y2="21"></line>
          <line x1="12" y1="17" x2="12" y2="21"></line>
        </svg>
        <span>Desktop App</span>
        <span id="badge-tab-desktop" class="hidden sm:inline-flex text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-black/10 text-black">App</span>
      </button>

      <button
        type="button"
        id="tab-btn-gradio"
        role="tab"
        aria-selected="false"
        aria-controls="view-gradio"
        class="inline-flex items-center justify-center gap-2 py-2 px-3.5 sm:px-5 rounded-full text-xs sm:text-sm font-semibold whitespace-nowrap transition-all duration-200 text-neutral-400 hover:text-white cursor-pointer shrink-0"
      >
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="4 17 10 11 4 5"></polyline>
          <line x1="12" y1="19" x2="20" y2="19"></line>
        </svg>
        <span>WebUI Gradio</span>
        <span id="badge-tab-gradio" class="hidden sm:inline-flex text-[10px] uppercase font-medium tracking-wider px-2 py-0.5 rounded-full bg-white/10 text-neutral-300">Classic</span>
      </button>
    </div>

    <!-- ================= VIEW 1: DESKTOP APP (DEFAULT) ================= -->
    <div id="view-desktop" class="flex flex-col items-center w-full">
      <!-- Platform Cards Container -->
      <div
        id="cards-container"
        class="flex flex-col md:flex-row items-stretch justify-center gap-6 max-w-6xl w-full"
      >
        <!-- Windows Card -->
        <div
          id="card-windows"
          data-platform="Windows"
          class="platform-card group relative flex flex-col items-center p-8 rounded-2xl backdrop-blur-md shadow-lg transition-all duration-300 w-full md:w-1/3 bg-white/5 border border-white/10 hover:bg-white/[0.08] hover:border-white/20"
        >
          <div
            id="badge-windows"
            class="recommended-badge hidden absolute -top-3 px-3 py-1 rounded-full bg-white text-black text-xs font-bold uppercase tracking-wider shadow-md"
          >
            Recommended
          </div>

          <div class="p-4 rounded-2xl bg-white/5 mb-6 group-hover:scale-110 transition-transform duration-300">
            <img
              src="/Windows.svg"
              alt="Windows logo"
              width="32"
              height="32"
              class="w-8 h-8"
            />
          </div>

          <h2 class="text-xl font-medium text-white mb-2">Windows</h2>
          <p class="text-white/70 text-sm mb-6 text-center">Windows 10/11 (64-bit)</p>

          <div class="w-full mt-auto">
            <a
              id="btn-windows"
              href={staticDownloads.windows}
              class="download-btn flex items-center justify-center gap-2 px-6 py-2.5 rounded-full font-semibold text-sm transition-all w-full bg-white/10 text-white hover:bg-white hover:text-black"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Download (.exe)</span>
            </a>
          </div>
        </div>

        <!-- macOS Card -->
        <div
          id="card-mac"
          data-platform="macOS"
          class="platform-card group relative flex flex-col items-center p-8 rounded-2xl backdrop-blur-md shadow-lg transition-all duration-300 w-full md:w-1/3 bg-white/5 border border-white/10 hover:bg-white/[0.08] hover:border-white/20"
        >
          <div
            id="badge-mac"
            class="recommended-badge hidden absolute -top-3 px-3 py-1 rounded-full bg-white text-black text-xs font-bold uppercase tracking-wider shadow-md"
          >
            Recommended
          </div>

          <div class="p-4 rounded-2xl bg-white/5 mb-6 group-hover:scale-110 transition-transform duration-300">
            <img
              src="/Apple.svg"
              alt="Apple logo"
              width="32"
              height="32"
              class="w-8 h-8"
            />
          </div>

          <h2 class="text-xl font-medium text-white mb-2">macOS</h2>
          <p class="text-white/70 text-sm mb-6 text-center">Apple Silicon & Intel (macOS 12+)</p>

          <div class="w-full mt-auto relative">
            <button
              type="button"
              id="toggle-mac-dropdown"
              aria-expanded="false"
              aria-haspopup="true"
              class="download-btn flex items-center justify-center gap-2 px-6 py-2.5 rounded-full w-full font-semibold text-sm transition-all bg-white/10 text-white hover:bg-white hover:text-black"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Download</span>
              <svg id="mac-chevron" class="w-4 h-4 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>

            <!-- macOS Dropdown Menu -->
            <div
              id="menu-mac"
              class="hidden absolute left-0 right-0 bottom-full mb-2 p-2 rounded-2xl bg-[#1A1A1A]/95 backdrop-blur-xl border border-white/10 shadow-2xl z-30 flex flex-col gap-1 text-left"
            >
              <div class="px-3 py-1.5 text-[11px] font-semibold tracking-wider uppercase text-white/40">
                Disk Image (.dmg)
              </div>
              <a
                id="link-mac-arm-dmg"
                href={staticDownloads.macArmDmg}
                class="flex items-center justify-between px-3.5 py-2 rounded-lg hover:bg-white/10 text-white/90 hover:text-white text-xs sm:text-sm transition-colors"
              >
                <span>Apple Silicon (M1/M2/M3/M4)</span>
                <span class="text-xs text-white/40 font-mono">.dmg</span>
              </a>
              <a
                id="link-mac-intel-dmg"
                href={staticDownloads.macIntelDmg}
                class="flex items-center justify-between px-3.5 py-2 rounded-lg hover:bg-white/10 text-white/90 hover:text-white text-xs sm:text-sm transition-colors"
              >
                <span>Intel Mac (x64)</span>
                <span class="text-xs text-white/40 font-mono">.dmg</span>
              </a>

              <div class="my-1 border-t border-white/10"></div>
              <div class="px-3 py-1 text-[11px] font-semibold tracking-wider uppercase text-white/40">
                Portable (.zip)
              </div>
              <a
                id="link-mac-arm-zip"
                href={staticDownloads.macArmZip}
                class="flex items-center justify-between px-3.5 py-1.5 rounded-lg hover:bg-white/10 text-white/60 hover:text-white text-xs transition-colors"
              >
                <span>Apple Silicon (.zip portable)</span>
                <svg class="w-3.5 h-3.5 text-white/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
              </a>

              <a
                id="link-mac-intel-zip"
                href={staticDownloads.macIntelZip}
                class="flex items-center justify-between px-3.5 py-1.5 rounded-lg hover:bg-white/10 text-white/60 hover:text-white text-xs transition-colors"
              >
                <span>Intel Mac (.zip portable)</span>
                <svg class="w-3.5 h-3.5 text-white/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Linux Card -->
        <div
          id="card-linux"
          data-platform="Linux"
          class="platform-card group relative flex flex-col items-center p-8 rounded-2xl backdrop-blur-md shadow-lg transition-all duration-300 w-full md:w-1/3 bg-white/5 border border-white/10 hover:bg-white/[0.08] hover:border-white/20"
        >
          <div
            id="badge-linux"
            class="recommended-badge hidden absolute -top-3 px-3 py-1 rounded-full bg-white text-black text-xs font-bold uppercase tracking-wider shadow-md"
          >
            Recommended
          </div>

          <div class="p-4 rounded-2xl bg-white/5 mb-6 group-hover:scale-110 transition-transform duration-300">
            <img
              src="/Linux.svg"
              alt="Linux logo"
              width="32"
              height="32"
              class="w-8 h-8"
            />
          </div>

          <h2 class="text-xl font-medium text-white mb-2">Linux</h2>
          <p class="text-white/70 text-sm mb-6 text-center">Select your distribution format</p>

          <div class="w-full mt-auto relative">
            <button
              type="button"
              id="toggle-linux-dropdown"
              aria-expanded="false"
              aria-haspopup="true"
              class="download-btn flex items-center justify-center gap-2 px-6 py-2.5 rounded-full w-full font-semibold text-sm transition-all bg-white/10 text-white hover:bg-white hover:text-black"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Download</span>
              <svg id="linux-chevron" class="w-4 h-4 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>

            <!-- Linux Dropdown Menu -->
            <div
              id="menu-linux"
              class="hidden absolute left-0 right-0 bottom-full mb-2 p-2 rounded-2xl bg-[#1A1A1A]/95 backdrop-blur-xl border border-white/10 shadow-2xl z-30 flex flex-col gap-1 text-left"
            >
              <div class="px-3 py-1.5 text-[11px] font-semibold tracking-wider uppercase text-white/40">
                Universal binary
              </div>
              <a
                id="link-linux-appimage"
                href={staticDownloads.linuxAppImage}
                class="flex items-center justify-between px-3.5 py-2 rounded-lg hover:bg-white/10 text-white/90 hover:text-white text-xs sm:text-sm transition-colors"
              >
                <div>
                  <span class="font-medium">AppImage</span>
                  <span class="block text-xs text-white/50">Most Linux distributions</span>
                </div>
                <svg class="w-4 h-4 text-white/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
              </a>

              <div class="my-1 border-t border-white/10"></div>
              <div class="px-3 py-1.5 text-[11px] font-semibold tracking-wider uppercase text-white/40">
                Debian / Ubuntu package
              </div>
              <a
                id="link-linux-deb"
                href={staticDownloads.linuxDeb}
                class="flex items-center justify-between px-3.5 py-2 rounded-lg hover:bg-white/10 text-white/90 hover:text-white text-xs sm:text-sm transition-colors"
              >
                <div>
                  <span class="font-medium">.deb installer</span>
                  <span class="block text-xs text-white/50">Debian, Ubuntu, Mint</span>
                </div>
                <svg class="w-4 h-4 text-white/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- macOS Gatekeeper Notice (only displayed if macOS detected) -->
      <div
        id="mac-notice"
        class="hidden mt-8 max-w-3xl w-full p-4 sm:p-5 rounded-2xl bg-white/[0.03] border border-white/10 text-xs sm:text-sm text-neutral-400"
      >
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-amber-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <div class="space-y-1.5">
            <p class="font-medium text-white">First time launching on macOS?</p>
            <p class="text-neutral-400 text-xs leading-relaxed">
              The application is not Apple-notarized yet. If macOS reports Applio is <span class="text-neutral-200">"damaged"</span>, open Terminal and run:
            </p>
            <div class="flex items-center gap-2 mt-2">
              <code class="px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-emerald-400 font-mono text-xs select-all">
                xattr -cr /Applications/Applio.app
              </code>
              <button
                id="copy-xattr-btn"
                type="button"
                class="px-2.5 py-1 rounded-md bg-white/10 hover:bg-white/20 text-white text-xs transition-colors"
              >
                Copy
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- GitHub Releases & CLI link for Desktop -->
      <p class="text-white/60 text-xs sm:text-sm mt-8 text-center">
        Looking for older desktop releases or commit history?{" "}
        <a
          href={releasesUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-white underline hover:text-neutral-200"
        >
          View Applio Desktop releases on GitHub
        </a>
      </p>
    </div>

    <!-- ================= VIEW 2: WEBUI GRADIO (CLASSIC) ================= -->
    <div id="view-gradio" class="hidden flex flex-col items-center w-full max-w-6xl">
      <!-- Gradio Hero Cards Container -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full">
        <!-- Windows Compiled Package -->
        <div class="group relative flex flex-col items-center p-8 rounded-2xl backdrop-blur-md shadow-lg transition-all duration-300 w-full bg-white/5 border border-white/10 hover:bg-white/[0.08] hover:border-white/20">
          <div class="absolute -top-3 px-3 py-1 rounded-full bg-white text-black text-xs font-bold uppercase tracking-wider shadow-md">
            Compiled .zip
          </div>

          <div class="p-4 rounded-2xl bg-white/5 mb-6 group-hover:scale-110 transition-transform duration-300">
            <img
              src="/Windows.svg"
              alt="Windows logo"
              width="32"
              height="32"
              class="w-8 h-8"
            />
          </div>

          <h2 class="text-xl font-medium text-white mb-1">Windows Compiled</h2>
          <span class="text-xs text-neutral-400 mb-3">Standalone portable package</span>
          <p class="text-white/70 text-sm mb-6 text-center">
            Pre-configured with embedded Python & PyTorch. Unzip and run <code class="text-emerald-400 font-mono text-xs">run-applio.bat</code>.
          </p>

          <div class="w-full mt-auto">
            <a
              href={staticDownloads.gradioWindowsZip}
              class="flex items-center justify-center gap-2 px-6 py-2.5 rounded-full font-semibold text-sm transition-all w-full bg-white text-black hover:bg-neutral-200"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Download (.zip)</span>
            </a>
            <p class="text-center text-[11px] text-neutral-500 mt-2">
              Hosted on Hugging Face &bull; v3.6.5
            </p>
          </div>
        </div>

        <!-- Git & Source Code -->
        <div class="group relative flex flex-col items-center p-8 rounded-2xl backdrop-blur-md shadow-lg transition-all duration-300 w-full bg-white/5 border border-white/10 hover:bg-white/[0.08] hover:border-white/20">
          <div class="p-4 rounded-2xl bg-white/5 mb-6 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="4 17 10 11 4 5"></polyline>
              <line x1="12" y1="19" x2="20" y2="19"></line>
            </svg>
          </div>

          <h2 class="text-xl font-medium text-white mb-1">Source & CLI</h2>
          <span class="text-xs text-neutral-400 mb-3">Linux, macOS, and Windows</span>
          <p class="text-white/70 text-sm mb-4 text-center">
            Clone the repository and run automated environment setup with hardware support.
          </p>

          <div class="w-full relative mb-5">
            <pre class="bg-black/40 border border-white/10 rounded-xl p-3 text-[11px] font-mono text-neutral-300 overflow-x-auto leading-relaxed text-left">git clone https://github.com/IAHispano/Applio.git
cd Applio
run-install.bat # or ./run-install.sh</pre>
            <button
              id="copy-git-btn"
              type="button"
              class="absolute top-2 right-2 px-2 py-0.5 rounded-md bg-white/10 hover:bg-white/20 text-white text-[10px] transition-colors"
            >
              Copy
            </button>
          </div>

          <div class="w-full mt-auto">
            <a
              href="https://github.com/IAHispano/Applio"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 px-6 py-2.5 rounded-full font-semibold text-sm transition-all w-full bg-white/10 text-white hover:bg-white hover:text-black"
            >
              <span>GitHub Repository</span>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>
        </div>

        <!-- Cloud & 1-Click Launchers -->
        <div class="group relative flex flex-col items-center p-8 rounded-2xl backdrop-blur-md shadow-lg transition-all duration-300 w-full bg-white/5 border border-white/10 hover:bg-white/[0.08] hover:border-white/20">
