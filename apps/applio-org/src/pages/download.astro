      <!-- Release Notes Banner for Gradio -->
      <div class="mt-8 max-w-4xl w-full p-4 sm:p-5 rounded-2xl bg-white/[0.03] border border-white/10 backdrop-blur-md flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="text-sm font-semibold text-white">Applio Gradio v3.6.5 Highlights</span>
            <span class="rounded-full bg-white/10 px-2 py-0.5 text-[11px] text-neutral-300">Classic WebUI</span>
          </div>
          <p class="text-neutral-400 text-xs mt-1">
            Overhauled CLI inference, RMVPE high-register pitch correction, TF32 and ZLUDA optimizations.
          </p>
