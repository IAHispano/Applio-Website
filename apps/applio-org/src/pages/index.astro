---
import GlowBackground from "../components/GlowBackground.astro";
import HeroPreview from "../components/HeroPreview.astro";
import Layout from "../layouts/Layout.astro";

interface BlogPost {
	title: string;
	description: string;
	date: string;
	tag: string;
}

const posts = import.meta.glob("./blog/*.astro", { eager: true });

const latestPosts: (BlogPost & { url: string })[] = Object.entries(posts)
	.filter(([path]) => path !== "./blog/index.astro")
	.map(([path, module]) => {
		const { frontmatter } = module as { frontmatter: BlogPost };
		return {
			...frontmatter,
			url: path.replace("./blog/", "/blog/").replace(".astro", ""),
		};
	})
	.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
	.slice(0, 2);
---

