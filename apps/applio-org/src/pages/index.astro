</Layout>

<script>
	function formatCount(n: number) {
		return new Intl.NumberFormat("en", {
			notation: "compact",
			maximumFractionDigits: 1,
		}).format(n);
	}

	async function loadRepositoryStats() {
		const container = document.getElementById("repo-stats");
		if (!container) return;

		try {
			const repoRes = await fetch(
				"https://api.github.com/repos/IAHispano/Applio",
			);
			if (!repoRes.ok) return;

			const repo = (await repoRes.json()) as {
				stargazers_count?: number;
				forks_count?: number;
			};
			if (typeof repo.stargazers_count !== "number") return;

			const starsEl = container.querySelector('[data-stat="stars"]');
			if (starsEl) {
				starsEl.textContent = formatCount(repo.stargazers_count);
			}

			const forksEl = container.querySelector('[data-stat="forks"]');
			if (forksEl && typeof repo.forks_count === "number") {
				forksEl.textContent = formatCount(repo.forks_count);
			}
		} catch {
			// silent fallback
		}
	}

	document.addEventListener("astro:page-load", loadRepositoryStats);
</script>
