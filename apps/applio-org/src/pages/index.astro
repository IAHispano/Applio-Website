<script>
	function formatCount(n: number) {
		return new Intl.NumberFormat("en", {
			notation: "compact",
			maximumFractionDigits: 1,
		}).format(n);
	}

	async function loadRepositoryStats() {
		const container = document.getElementById("repo-stats");
		if (!container) return;

		try {
			const repoRes = await fetch(
				"https://api.github.com/repos/IAHispano/Applio",
			);
			if (!repoRes.ok) throw new Error("Failed to load repository data");

			const repo = (await repoRes.json()) as {
				stargazers_count?: number;
				forks_count?: number;
			};
			if (typeof repo.stargazers_count !== "number") {
				throw new Error("Missing repository data");
			}

			const starsEl = container.querySelector('[data-stat="stars"]');
			if (starsEl) {
				starsEl.textContent = formatCount(repo.stargazers_count);
			}

			const forksEl = container.querySelector('[data-stat="forks"]');
			if (forksEl && typeof repo.forks_count === "number") {
				forksEl.textContent = formatCount(repo.forks_count);
			}

			try {
				const contribRes = await fetch(
					"https://api.github.com/repos/IAHispano/Applio/contributors?per_page=1",
				);
				const link = contribRes.headers.get("link") || "";
				const match = link.match(/page=(\d+)>;\s*rel="last"/);
				if (match) {
					const contribEl = container.querySelector(
						'[data-stat="contributors"]',
					);
					if (contribEl) {
						contribEl.textContent = formatCount(Number(match[1]));
					}
				}
			} catch {
				// contributors count is optional; stars still show
			}

			container.hidden = false;
		} catch {
			container.hidden = true;
		}
	}

	async function loadContributors() {
		const container = document.getElementById("contributors");
		const avatarsEl = document.getElementById("contributor-avatars");
		const countEl = document.getElementById("contributors-count");
		if (!container || !avatarsEl || !countEl) return;

		try {
			const contributors: {
				login?: string | null;
				avatar_url?: string;
				html_url?: string;
			}[] = [];
			let page = 1;
			while (true) {
				const res = await fetch(
					`https://api.github.com/repos/IAHispano/Applio/contributors?per_page=100&page=${page}`,
				);
				if (!res.ok) throw new Error("Failed to load contributors");

				const batch = (await res.json()) as typeof contributors;
				if (!Array.isArray(batch) || batch.length === 0) break;
				contributors.push(...batch);

				const link = res.headers.get("link") || "";
				if (!link.includes('rel="next"') || page >= 10) break;
				page += 1;
			}

			const people = contributors.filter((c) => c.login);
			if (people.length === 0) return;

			countEl.textContent = String(people.length);

			const frag = document.createDocumentFragment();
			for (const c of people) {
				const a = document.createElement("a");
				a.href = c.html_url || `https://github.com/${c.login}`;
				a.target = "_blank";
				a.rel = "noopener noreferrer";
				a.title = c.login ?? "Contributor";
				a.className =
					"transition-transform duration-200 hover:-translate-y-0.5";

				const img = document.createElement("img");
				img.src = `${c.avatar_url ?? ""}&s=80`;
				img.alt = c.login ?? "Contributor";
				img.width = 40;
				img.height = 40;
				img.loading = "lazy";
				img.className =
					"h-10 w-10 rounded-full border-2 border-[#161414] bg-white/10 object-cover transition-all duration-200 hover:border-white/50";

				a.appendChild(img);
				frag.appendChild(a);
			}
			avatarsEl.appendChild(frag);
			container.style.display = "flex";
		} catch {
			// keep the section hidden if the API is unreachable
		}
	}

	document.addEventListener("astro:page-load", () => {
		loadRepositoryStats();
		loadContributors();
	});
</script>