---
import Layout from "../layouts/Layout.astro";
import GlowBackground from "../components/GlowBackground.astro";
---

<Layout>
  <GlowBackground />

  {/* hero */}
  <section
    class="relative flex flex-col items-center justify-center min-h-[100dvh] px-6 py-16 text-center"
  >
    <span
      class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs text-neutral-300 backdrop-blur-sm animate-fade-in"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
      Open source &middot; MIT licensed &middot; Free forever
    </span>

    <h1
      class="mt-8 text-6xl md:text-7xl xl:text-8xl font-bold text-white tracking-tight animate-fade-in"
    >
      Applio
    </h1>

    <p class="mt-6 mb-12 max-w-2xl text-lg text-neutral-200 animate-fade-in">
      A simple, high-quality voice conversion tool focused on ease of use and
      performance. Create AI covers, train custom voice models, and convert
      voices in real time.
    </p>

    <div class="flex flex-wrap gap-4 items-center justify-center animate-fade-in">
      <a
        href="https://docs.applio.org/getting-started/installation/"
        target="_blank"
        class="px-8 py-3 bg-white text-black font-medium rounded-full hover:bg-neutral-200 transition-all duration-300"
      >
        Download
      </a>

      <a
        href="/playground"
        class="px-8 py-3 bg-white/10 backdrop-blur-sm text-white font-medium rounded-full hover:bg-white/20 transition-all duration-300"
      >
        Try the playground
      </a>

      <a
        href="https://github.com/IAHispano/Applio"
        target="_blank"
        aria-label="Applio on GitHub"
        class="flex items-center justify-center w-12 h-12 rounded-full bg-white/10 backdrop-blur-sm hover:bg-white/20 transition-all duration-300"
      >
        <svg
          class="w-5 h-5"
          viewBox="0 0 24 24"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.04-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49.99.11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.94 0-1.31.47-2.39 1.24-3.23-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.56 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.92 1.23 3.23 0 4.61-2.8 5.63-5.48 5.93.43.37.81 1.1.81 2.22 0 1.6-.01 2.88-.01 3.27 0 .32.21.7.82.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"
          />
        </svg>
      </a>

      <a
        href="/discord"
        target="_blank"
        aria-label="Join the Applio Discord server"
        class="flex items-center justify-center w-12 h-12 rounded-full bg-white/10 backdrop-blur-sm hover:bg-white/20 transition-all duration-300"
      >
        <svg
          class="w-5 h-5"
          viewBox="0 0 30 23"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M25.1716 1.88417C23.2874 1.00583 21.2474 0.368333 19.1224 0C19.085 0.000532248 19.0494 0.0158083 19.0232 0.0425003C18.7682 0.51 18.4707 1.11917 18.2724 1.58667C16.0185 1.24688 13.7263 1.24688 11.4724 1.58667C11.2741 1.105 10.9766 0.51 10.7074 0.0425003C10.6932 0.014167 10.6507 0 10.6082 0C8.48323 0.368333 6.4574 1.00583 4.55907 1.88417C4.5449 1.88417 4.53073 1.89833 4.51657 1.9125C0.663233 7.67833 -0.399268 13.2883 0.124899 18.8417C0.124899 18.87 0.139066 18.8983 0.167399 18.9125C2.7174 20.7825 5.16823 21.9158 7.59073 22.6667C7.63323 22.6808 7.67573 22.6667 7.6899 22.6383C8.25657 21.8592 8.76657 21.0375 9.20573 20.1733C9.23407 20.1167 9.20573 20.06 9.14907 20.0458C8.34157 19.7342 7.57657 19.3658 6.82573 18.9408C6.76907 18.9125 6.76907 18.8275 6.81157 18.785C6.9674 18.6717 7.12323 18.5442 7.27907 18.4308C7.3074 18.4025 7.3499 18.4025 7.37823 18.4167C12.2516 20.6408 17.5074 20.6408 22.3241 18.4167C22.3524 18.4025 22.3949 18.4025 22.4232 18.4308C22.5791 18.5583 22.7349 18.6717 22.8907 18.7992C22.9474 18.8417 22.9474 18.9267 22.8766 18.955C22.1399 19.3942 21.3607 19.7483 20.5532 20.06C20.4966 20.0742 20.4824 20.145 20.4966 20.1875C20.9499 21.0517 21.4599 21.8733 22.0124 22.6525C22.0549 22.6667 22.0974 22.6808 22.1399 22.6667C24.5766 21.9158 27.0274 20.7825 29.5774 18.9125C29.6057 18.8983 29.6199 18.87 29.6199 18.8417C30.2432 12.4242 28.5857 6.85667 25.2282 1.9125C25.2141 1.89833 25.1999 1.88417 25.1716 1.88417ZM9.9424 15.4558C8.48323 15.4558 7.2649 14.11 7.2649 12.4525C7.2649 10.795 8.4549 9.44917 9.9424 9.44917C11.4441 9.44917 12.6341 10.8092 12.6199 12.4525C12.6199 14.11 11.4299 15.4558 9.9424 15.4558ZM19.8166 15.4558C18.3574 15.4558 17.1391 14.11 17.1391 12.4525C17.1391 10.795 18.3291 9.44917 19.8166 9.44917C21.3182 9.44917 22.5082 10.8092 22.4941 12.4525C22.4941 14.11 21.3182 15.4558 19.8166 15.4558Z"></path>
        </svg>
      </a>

      <a
        href="/donate"
        target="_blank"
        aria-label="Support Applio on Ko-fi"
        class="flex items-center justify-center w-12 h-12 rounded-full bg-white/10 backdrop-blur-sm hover:bg-white/20 transition-all duration-300"
      >
        <svg
          class="w-5 h-5"
          viewBox="0 0 26 23"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M9.52545 4.69992e-05C7.29182 -0.0114129 5.11727 2.07428 6.11 4.66421H2.36364C1.73676 4.66421 1.13556 4.90569 0.692293 5.33552C0.249025 5.76534 0 6.34832 0 6.95619V9.24816C0 9.55209 0.124513 9.84358 0.346146 10.0585C0.56778 10.2734 0.86838 10.3941 1.18182 10.3941H11.8182V6.95619H14.1818V10.3941H24.8182C25.1316 10.3941 25.4322 10.2734 25.6539 10.0585C25.8755 9.84358 26 9.55209 26 9.24816V6.95619C26 6.34832 25.751 5.76534 25.3077 5.33552C24.8644 4.90569 24.2632 4.66421 23.6364 4.66421H19.89C21.2727 0.916837 16.0727 -1.73039 13.6736 1.50129L13 2.37224L12.3264 1.47837C11.5818 0.458442 10.5536 0.0115069 9.52545 4.69992e-05ZM9.45455 2.37224C10.5064 2.37224 11.0382 3.60991 10.2936 4.33188C9.54909 5.05385 8.27273 4.53815 8.27273 3.51823C8.27273 3.21429 8.39724 2.92281 8.61887 2.70789C8.84051 2.49298 9.14111 2.37224 9.45455 2.37224ZM16.5455 2.37224C17.5973 2.37224 18.1291 3.60991 17.3845 4.33188C16.64 5.05385 15.3636 4.53815 15.3636 3.51823C15.3636 3.21429 15.4881 2.92281 15.7098 2.70789C15.9314 2.49298 16.232 2.37224 16.5455 2.37224ZM1.18182 11.5401V20.708C1.18182 21.3159 1.43084 21.8989 1.87411 22.3287C2.31738 22.7585 2.91858 23 3.54545 23H22.4545C23.0814 23 23.6826 22.7585 24.1259 22.3287C24.5692 21.8989 24.8182 21.3159 24.8182 20.708V11.5401H14.1818V20.708H11.8182V11.5401H1.18182Z"
            fill="#FFFFFF"
          ></path>
        </svg>
      </a>
    </div>

    <p class="mt-6 text-sm text-neutral-400">
      Available on Windows, Linux, macOS & supported cloud platforms.
    </p>

    <a
      href="#features"
      aria-label="Scroll to features"
      class="absolute bottom-8 p-2 text-neutral-500 hover:text-white transition-colors duration-200 animate-bounce-y"
    >
      <svg
        class="w-6 h-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M6 9l6 6 6-6"></path>
      </svg>
    </a>
  </section>

  {/* features */}
  <section id="features" class="relative px-6 py-24">
    <div class="max-w-6xl mx-auto">
      <p class="text-sm text-neutral-400 uppercase tracking-widest">Features</p>
      <h2 class="mt-3 text-4xl md:text-5xl font-bold text-white tracking-tight">
        Everything you need for voice conversion
      </h2>
      <p class="mt-4 max-w-2xl text-lg text-neutral-300">
        From a single cover to a fully custom voice, Applio ships with a
        complete set of tools for voice work.
      </p>

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <a
          href="https://docs.applio.org/getting-started/inference/"
          target="_blank"
          class="group block p-8 bg-white/5 border border-white/10 backdrop-blur-sm rounded-2xl hover:bg-white/10 hover:border-white/20 transition-all duration-300"
        >
          <div class="flex items-center justify-between">
            <svg
              class="w-7 h-7 text-white/70"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="9" y="2" width="6" height="12" rx="3"></rect>
              <path d="M5 10v1a7 7 0 0 0 14 0v-1"></path>
              <line x1="12" y1="18" x2="12" y2="22"></line>
            </svg>
            <span class="text-white/30 group-hover:text-white/60 transition-colors duration-300">→</span>
          </div>
          <h3 class="mt-6 text-xl font-semibold text-white">Voice Conversion</h3>
          <p class="mt-2 text-neutral-300 text-sm leading-relaxed">
            Convert any audio into another voice with ready-made voice models.
            Tune pitch, clean, upscale, and batch-process files effortlessly.
          </p>
        </a>

        <a
          href="https://docs.applio.org/getting-started/realtime/"
          target="_blank"
          class="group block p-8 bg-white/5 backdrop-blur-sm rounded-2xl hover:bg-white/10 hover:border-white/20 transition-all duration-300 border border-white/10"
        >
          <div class="flex items-center justify-between">
            <svg
              class="w-7 h-7 text-white/70"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path>
            </svg>
            <span class="text-white/30 group-hover:text-white/60 transition-colors duration-300">→</span>
          </div>
          <h3 class="mt-6 text-xl font-semibold text-white">Real-Time Voice</h3>
          <p class="mt-2 text-neutral-300 text-sm leading-relaxed">
            Change your voice live with low-latency inference, perfect for songs,
            streams, and calls.
          </p>
        </a>

        <a
          href="https://docs.applio.org/getting-started/training/"
          target="_blank"
          class="group block p-8 bg-white/5 backdrop-blur-sm rounded-2xl hover:bg-white/10 hover:border-white/20 transition-all duration-300 border border-white/10"
        >
          <div class="flex items-center justify-between">
            <svg
              class="w-7 h-7 text-white/70"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m12 2 10 5-10 5L2 7l10-5z"></path>
              <path d="m2 17 10 5 10-5"></path>
              <path d="m2 12 10 5 10-5"></path>
            </svg>
            <span class="text-white/30 group-hover:text-white/60 transition-colors duration-300">→</span>
          </div>
          <h3 class="mt-6 text-xl font-semibold text-white">Model Training</h3>
          <p class="mt-2 text-neutral-300 text-sm leading-relaxed">
            Train your own voice from your dataset. Pre-process, extract, train
            and export a model in just a few steps.
          </p>
        </a>

        <a
          href="https://docs.applio.org/getting-started/voice-blender/"
          target="_blank"
          class="group block p-8 bg-white/5 backdrop-blur-sm rounded-2xl hover:bg-white/10 hover:border-white/20 transition-all duration-300 border border-white/10"
        >
          <div class="flex items-center justify-between">
            <svg
              class="w-7 h-7 text-white/70"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="4" y1="21" x2="4" y2="14"></line>
              <line x1="4" y1="10" x2="4" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12" y2="3"></line>
              <line x1="20" y1="21" x2="20" y2="16"></line>
              <line x1="20" y1="12" x2="20" y2="3"></line>
              <line x1="1" y1="14" x2="7" y2="14"></line>
              <line x1="9" y1="8" x2="15" y2="8"></line>
              <line x1="17" y1="16" x2="23" y2="16"></line>
            </svg>
            <span class="text-white/30 group-hover:text-white/60 transition-colors duration-300">→</span>
          </div>
          <h3 class="mt-6 text-xl font-semibold text-white">Voice Blender</h3>
          <p class="mt-2 text-neutral-300 text-sm leading-relaxed">
            Blend multiple voice models into one unique new voice with full
            control over each contributor.
          </p>
        </a>

        <a
          href="https://docs.applio.org/getting-started/tts/"
          target="_blank"
          class="group block p-8 bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl hover:bg-white/10 hover:border-white/20 transition-all duration-300"
        >
          <div class="flex items-center justify-between">
            <svg
              class="w-7 h-7 text-white/70"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            <span class="text-white/30 group-hover:text-white/60 transition-colors duration-300">→</span>
          </div>
          <h3 class="mt-6 text-xl font-semibold text-white">Text-to-Speech</h3>
          <p class="mt-2 text-neutral-300 text-sm leading-relaxed">
            Generate speech from text and run it through your voice models,
            opening up a whole world of content.
          </p>
        </a>

        <a
          href="https://docs.applio.org/getting-started/audio-analyzer/"
          target="_blank"
          class="group block p-8 bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl hover:bg-white/10 hover:border-white/20 transition-all duration-300"
        >
          <div class="flex items-center justify-between">
            <svg
              class="w-7 h-7 text-white/70"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
            <span class="text-white/30 group-hover:text-white/60 transition-colors duration-300">→</span>
          </div>
          <h3 class="mt-6 text-xl font-semibold text-white">Audio Analyzer</h3>
          <p class="mt-2 text-neutral-300 text-sm leading-relaxed">
            Prepare your datasets and check their readiness with detailed audio
            health information before training.
          </p>
        </a>
      </div>
    </div>
  </section>

  {/* how it works */}
  <section id="get-started" class="relative px-6 py-24">
    <div class="max-w-6xl mx-auto">
      <p class="text-sm text-neutral-400 uppercase tracking-widest">Get started</p>
      <h2 class="mt-3 text-4xl md:text-5xl font-bold text-white tracking-tight">
        From zero to your first conversion
      </h2>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <div
          class="group relative overflow-hidden rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-white/20 hover:bg-white/10"
        >
          <span
            class="pointer-events-none absolute -top-3 right-2 select-none text-[72px] leading-none font-bold text-white/[0.04]"
            aria-hidden="true"
          >
            1
          </span>
          <div class="relative flex h-full flex-col">
            <div class="flex items-center gap-3">
              <span
                class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-white"
              >
                <svg
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
              </span>
              <span
                class="text-xs font-semibold uppercase tracking-widest text-neutral-500"
              >
                Step 1
              </span>
            </div>
            <h3 class="mt-5 text-xl font-semibold text-white">Install Applio</h3>
            <p class="mt-2 grow text-sm leading-relaxed text-neutral-300">
              Run the install script for Windows, Linux or Mac. No prerequisites
              — everything is bundled.
            </p>
            <a
              href="https://docs.applio.org/getting-started/installation/"
              target="_blank"
              class="mt-5 inline-flex w-fit items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm text-white transition-all duration-300 hover:gap-3 hover:bg-white/20"
            >
              Installation guide
              <svg
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>

        <div
          class="group relative overflow-hidden rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-white/20 hover:bg-white/10"
        >
          <span
            class="pointer-events-none absolute -top-3 right-2 select-none text-[72px] leading-none font-bold text-white/[0.04]"
            aria-hidden="true"
          >
            2
          </span>
          <div class="relative flex h-full flex-col">
            <div class="flex items-center gap-3">
              <span
                class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-white"
              >
                <svg
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="9" y="2" width="6" height="12" rx="3"></rect>
                  <path d="M5 10v1a7 7 0 0 0 14 0v-1"></path>
                  <line x1="12" y1="18" x2="12" y2="22"></line>
                </svg>
              </span>
              <span
                class="text-xs font-semibold uppercase tracking-widest text-neutral-500"
              >
                Step 2
              </span>
            </div>
            <h3 class="mt-5 text-xl font-semibold text-white">
              Pick or train a voice
            </h3>
            <p class="mt-2 grow text-sm leading-relaxed text-neutral-300">
              Use a ready-made voice model, or train your own with audio you
              provide. Pre-trained models are available as a base for training.
            </p>
            <a
              href="/search"
              class="mt-5 inline-flex w-fit items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm text-white transition-all duration-300 hover:gap-3 hover:bg-white/20"
            >
              Find voice models
              <svg
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>

        <div
          class="group relative overflow-hidden rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-white/20 hover:bg-white/10"
        >
          <span
            class="pointer-events-none absolute -top-3 right-2 select-none text-[72px] leading-none font-bold text-white/[0.04]"
            aria-hidden="true"
          >
            3
          </span>
          <div class="relative flex h-full flex-col">
            <div class="flex items-center gap-3">
              <span
                class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-white"
              >
                <svg
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
              </span>
              <span
                class="text-xs font-semibold uppercase tracking-widest text-neutral-500"
              >
                Step 3
              </span>
            </div>
            <h3 class="mt-5 text-xl font-semibold text-white">
              Convert your audio
            </h3>
            <p class="mt-2 grow text-sm leading-relaxed text-neutral-300">
              Upload a song, speech, or your microphone and let Applio handle
              the rest.
            </p>
            <a
