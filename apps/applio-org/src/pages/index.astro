---
import Icon from "../../../../shared/Icon.astro";
import Layout from "../layouts/Layout.astro";
import WorkspacePreview from "../components/WorkspacePreview.astro";
import "../styles/home.css";
import { ecosystem } from "../lib/ecosystem";

interface BlogPost {
  title: string;
  description: string;
  date: string;
  tag: string;
}
const posts = import.meta.glob("./blog/*.astro", { eager: true });
const latestPosts: (BlogPost & { url: string })[] = Object.entries(posts)
  .filter(([path]) => path !== "./blog/index.astro")
  .map(([path, module]) => ({
    ...(module as { frontmatter: BlogPost }).frontmatter,
    url: path.replace("./blog/", "/blog/").replace(".astro", ""),
  }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 2);
---
<Layout>
  <section class="home-hero">
    <div class="hero-copy">
      <a class="release-link" href="/download"><span aria-hidden="true"></span> Meet Applio Desktop <Icon name="arrow-right" /></a>
      <p class="hero-eyebrow">YOUR VOICE. YOUR WORKSPACE.</p>
      <h1>Make every<br />voice your own.</h1>
      <p class="hero-description">Convert audio, change your voice live, and train custom models. One open-source workspace for everything you create with voice.</p>
      <div class="hero-actions"><a class="primary-action" href="/download">Download Applio <Icon name="download" /></a><a class="secondary-action" href={ecosystem.links.docs}>Read the docs <Icon name="external-link" /></a></div>
      <p class="platform-note">Windows, macOS & Linux <span>·</span> Free & open source</p>
    </div>
    <WorkspacePreview />
  </section>
  <div class="workflow-strip" aria-label="Explore Applio workflows">
    <span>FROM IDEA TO AUDIO</span>
    <a href={new URL("getting-started/inference/", ecosystem.links.docs).href}>Convert audio <Icon name="external-link" size={12} /></a>
    <a href={new URL("getting-started/realtime/", ecosystem.links.docs).href}>Go live <Icon name="external-link" size={12} /></a>
    <a href={new URL("getting-started/training/", ecosystem.links.docs).href}>Train a model <Icon name="external-link" size={12} /></a>
    <a href="/playground">Try the playground <Icon name="arrow-right" size={12} /></a>
  </div>
  {/* features */}
  <section id="features" class="relative px-6 py-20">
    <div class="max-w-6xl mx-auto">
      <p class="text-sm text-neutral-400 uppercase tracking-widest">Features</p>
      <h2 class="mt-3 text-4xl md:text-5xl font-bold text-white tracking-tight">
        Everything you need for voice conversion
      </h2>
      <p class="mt-4 max-w-2xl text-lg text-neutral-300">
        From a single cover to a fully custom voice, Applio ships with a
        complete set of tools for audio work.
      </p>

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <a
          href="https://docs.applio.org/getting-started/inference/"
          target="_blank"
          class="group block p-8 bg-white/5 border border-white/10 backdrop-blur-sm rounded-xl hover:bg-white/10 hover:border-white/20 transition-all duration-300"
        >
          <div class="flex items-center justify-between">
            <svg
              class="w-7 h-7 text-white/70"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="9" y="2" width="6" height="12" rx="3"></rect>
              <path d="M5 10v1a7 7 0 0 0 14 0v-1"></path>
              <line x1="12" y1="18" x2="12" y2="22"></line>
            </svg>
            <span class="text-white/30 group-hover:text-white/60 transition-colors duration-300"><Icon name="arrow-right" /></span>
          </div>
          <h3 class="mt-6 text-xl font-semibold text-white">Voice Conversion</h3>
          <p class="mt-2 text-neutral-300 text-sm leading-relaxed">
            Convert any audio into another voice with ready-made voice models.
            Tune pitch, clean, upscale, and batch-process files effortlessly.
          </p>
        </a>

        <a
          href="https://docs.applio.org/getting-started/realtime/"
          target="_blank"
          class="group block p-8 bg-white/5 backdrop-blur-sm rounded-xl hover:bg-white/10 hover:border-white/20 transition-all duration-300 border border-white/10"
        >
          <div class="flex items-center justify-between">
            <svg
              class="w-7 h-7 text-white/70"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path>
            </svg>
            <span class="text-white/30 group-hover:text-white/60 transition-colors duration-300"><Icon name="arrow-right" /></span>
          </div>
          <h3 class="mt-6 text-xl font-semibold text-white">Real-Time Voice</h3>
          <p class="mt-2 text-neutral-300 text-sm leading-relaxed">
            Change your voice live with low-latency inference, perfect for songs,
            streams, and calls.
          </p>
        </a>

        <a
          href="https://docs.applio.org/getting-started/training/"
          target="_blank"
          class="group block p-8 bg-white/5 backdrop-blur-sm rounded-xl hover:bg-white/10 hover:border-white/20 transition-all duration-300 border border-white/10"
        >
          <div class="flex items-center justify-between">
            <svg
              class="w-7 h-7 text-white/70"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m12 2 10 5-10 5L2 7l10-5z"></path>
              <path d="m2 17 10 5 10-5"></path>
              <path d="m2 12 10 5 10-5"></path>
            </svg>
            <span class="text-white/30 group-hover:text-white/60 transition-colors duration-300"><Icon name="arrow-right" /></span>
          </div>
          <h3 class="mt-6 text-xl font-semibold text-white">Model Training</h3>
          <p class="mt-2 text-neutral-300 text-sm leading-relaxed">
            Train your own voice from your dataset. Pre-process, extract, train
            and export a model in just a few steps.
          </p>
        </a>

        <a
          href="https://docs.applio.org/getting-started/voice-blender/"
          target="_blank"
          class="group block p-8 bg-white/5 backdrop-blur-sm rounded-xl hover:bg-white/10 hover:border-white/20 transition-all duration-300 border border-white/10"
        >
          <div class="flex items-center justify-between">
            <svg
              class="w-7 h-7 text-white/70"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="4" y1="21" x2="4" y2="14"></line>
              <line x1="4" y1="10" x2="4" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12" y2="3"></line>
              <line x1="20" y1="21" x2="20" y2="16"></line>
              <line x1="20" y1="12" x2="20" y2="3"></line>
              <line x1="1" y1="14" x2="7" y2="14"></line>
              <line x1="9" y1="8" x2="15" y2="8"></line>
              <line x1="17" y1="16" x2="23" y2="16"></line>
            </svg>
            <span class="text-white/30 group-hover:text-white/60 transition-colors duration-300"><Icon name="arrow-right" /></span>
          </div>
          <h3 class="mt-6 text-xl font-semibold text-white">Voice Blender</h3>
          <p class="mt-2 text-neutral-300 text-sm leading-relaxed">
            Blend multiple voice models into one unique new voice with full
            control over each contributor.
          </p>
        </a>

        <a
          href="https://docs.applio.org/getting-started/tts/"
          target="_blank"
          class="group block p-8 bg-white/5 backdrop-blur-sm border border-white/10 rounded-xl hover:bg-white/10 hover:border-white/20 transition-all duration-300"
        >
          <div class="flex items-center justify-between">
            <svg
              class="w-7 h-7 text-white/70"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            <span class="text-white/30 group-hover:text-white/60 transition-colors duration-300"><Icon name="arrow-right" /></span>
          </div>
          <h3 class="mt-6 text-xl font-semibold text-white">Text-to-Speech</h3>
          <p class="mt-2 text-neutral-300 text-sm leading-relaxed">
            Generate speech from text and run it through your voice models,
            opening up a whole world of content.
          </p>
        </a>

        <a
          href="https://docs.applio.org/getting-started/audio-analyzer/"
          target="_blank"
          class="group block p-8 bg-white/5 backdrop-blur-sm border border-white/10 rounded-xl hover:bg-white/10 hover:border-white/20 transition-all duration-300"
        >
          <div class="flex items-center justify-between">
            <svg
              class="w-7 h-7 text-white/70"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
            <span class="text-white/30 group-hover:text-white/60 transition-colors duration-300"><Icon name="arrow-right" /></span>
          </div>
          <h3 class="mt-6 text-xl font-semibold text-white">Audio Analyzer</h3>
          <p class="mt-2 text-neutral-300 text-sm leading-relaxed">
            Prepare your datasets and check their readiness with detailed audio
            health information before training.
          </p>
        </a>
      </div>
    </div>
  </section>

  {/* how it works */}
  <section id="get-started" class="relative px-6 py-20">
    <div class="max-w-6xl mx-auto">
      <p class="text-sm text-neutral-400 uppercase tracking-widest">Get started</p>
      <h2 class="mt-3 text-4xl md:text-5xl font-bold text-white tracking-tight">
        From zero to your first conversion
      </h2>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <div
          class="group relative overflow-hidden rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-all duration-300 hover:border-white/20 hover:bg-white/[0.08]"
        >
          <span
            class="pointer-events-none absolute -top-3 right-2 select-none text-[72px] leading-none font-bold text-white/[0.04]"
            aria-hidden="true"
          >
            1
          </span>
          <div class="relative flex h-full flex-col">
            <div class="flex items-center gap-3">
              <span
                class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-white"
              >
                <svg
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
              </span>
              <span
                class="text-xs font-semibold uppercase tracking-widest text-neutral-500"
              >
                Step 1
              </span>
            </div>
            <h3 class="mt-5 text-xl font-semibold text-white">Get Applio</h3>
            <p class="mt-2 grow text-sm leading-relaxed text-neutral-300">
              Download the standalone Desktop app or choose the classic Gradio WebUI.
            </p>
            <div class="mt-5 flex items-center gap-2">
              <a
                href="/download"
                class="inline-flex items-center gap-1.5 rounded-full bg-white text-black px-4 py-1.5 text-xs font-semibold transition-all hover:bg-neutral-200"
              >
                Download Applio
                <Icon name="arrow-right" />
              </a>
            </div>
          </div>
        </div>

        <div
          class="group relative overflow-hidden rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-all duration-300 hover:border-white/20 hover:bg-white/[0.08]"
        >
          <span
            class="pointer-events-none absolute -top-3 right-2 select-none text-[72px] leading-none font-bold text-white/[0.04]"
            aria-hidden="true"
          >
            2
          </span>
          <div class="relative flex h-full flex-col">
            <div class="flex items-center gap-3">
              <span
                class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-white"
              >
                <svg
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="9" y="2" width="6" height="12" rx="3"></rect>
                  <path d="M5 10v1a7 7 0 0 0 14 0v-1"></path>
                  <line x1="12" y1="18" x2="12" y2="22"></line>
                </svg>
              </span>
              <span
                class="text-xs font-semibold uppercase tracking-widest text-neutral-500"
              >
                Step 2
              </span>
            </div>
            <h3 class="mt-5 text-xl font-semibold text-white">
              Pick or train a voice
            </h3>
            <p class="mt-2 grow text-sm leading-relaxed text-neutral-300">
              Use community-shared voice models, or train your own voice with your
              own audio datasets.
            </p>
            <a
              href="/search"
              class="mt-5 inline-flex w-fit items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm text-white transition-all duration-300 hover:gap-3 hover:bg-white/20"
            >
              Find voice models
              <svg
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>

        <div
          class="group relative overflow-hidden rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-all duration-300 hover:border-white/20 hover:bg-white/[0.08]"
        >
          <span
            class="pointer-events-none absolute -top-3 right-2 select-none text-[72px] leading-none font-bold text-white/[0.04]"
            aria-hidden="true"
          >
            3
          </span>
          <div class="relative flex h-full flex-col">
            <div class="flex items-center gap-3">
              <span
                class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-white"
              >
                <svg
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
              </span>
              <span
                class="text-xs font-semibold uppercase tracking-widest text-neutral-500"
              >
                Step 3
              </span>
            </div>
            <h3 class="mt-5 text-xl font-semibold text-white">
              Convert your audio
            </h3>
            <p class="mt-2 grow text-sm leading-relaxed text-neutral-300">
              Transform songs, speech, or microphone input with high fidelity
              and real-time inference.
            </p>
            <a
              href="/playground"
              class="mt-5 inline-flex w-fit items-center gap-2 rounded-full bg-white text-black px-4 py-1.5 text-sm font-medium transition-all duration-300 hover:gap-3 hover:bg-neutral-200"
            >
              Test in playground
              <svg
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* open source */}
  <section id="open-source" class="relative px-6 py-20">
    <div class="max-w-6xl mx-auto">
      <p class="text-sm text-neutral-400 uppercase tracking-widest">Open source</p>
      <h2 class="mt-3 text-4xl md:text-5xl font-bold text-white tracking-tight">
        Built in the open, free for everyone
      </h2>
      <p class="mt-4 max-w-2xl text-lg text-neutral-300">
        Applio is an open source, community-driven project. No accounts, no paywalls,
        and no telemetry &mdash; just pure, auditable code.
      </p>

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <div
          class="p-8 border border-white/10 bg-white/5 backdrop-blur-sm rounded-xl"
        >
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-white">
            <svg
              class="w-5 h-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M20.91 11.12a1 1 0 0 0-1.59-.73l-4.44 3.43-1.63-5.19a1 1 0 0 0-1.84-.17L8.6 12.16H4.6a1 1 0 0 0 0 2h4.79a1 1 0 0 0 .95-.68l1.03-3.27 1.63 5.19a1 1 0 0 0 1.84.17l1.63-5.19.6.46a1 1 0 0 0 1.03.73H21a1 1 0 0 0-.09-1.9Z"></path>
            </svg>
          </div>
          <h3 class="mt-5 text-xl font-semibold text-white">MIT licensed</h3>
          <p class="mt-2 text-sm leading-relaxed text-neutral-300">
            Use, modify, and redistribute Applio freely for personal projects,
            research, or commercial work.
          </p>
        </div>

        <div
          class="p-8 border border-white/10 bg-white/5 backdrop-blur-sm rounded-xl"
        >
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-white">
            <svg
              class="w-5 h-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <h3 class="mt-5 text-xl font-semibold text-white">Community driven</h3>
          <p class="mt-2 text-sm leading-relaxed text-neutral-300">
            Maintained by creators and contributors around the world. Every feature,
            bug fix, and roadmap item is discussed openly.
          </p>
        </div>

        <div
          class="p-8 border border-white/10 bg-white/5 backdrop-blur-sm rounded-xl"
        >
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-white">
            <svg
              class="w-5 h-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3 class="mt-5 text-xl font-semibold text-white">Transparent by default</h3>
          <p class="mt-2 text-sm leading-relaxed text-neutral-300">
            No telemetry and no account needed. Everything runs locally on your machine,
            fully open for anyone to inspect.
          </p>
        </div>
      </div>

      {/* repository stats */}
      <div
        id="repo-stats"
        class="mt-12 flex flex-wrap items-center justify-center gap-3"
      >
        <span
          class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-5 py-2 text-sm text-neutral-300 backdrop-blur-sm"
        >
          <svg
            class="w-4 h-4 text-amber-400"
            viewBox="0 0 24 24"
            fill="currentColor"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
          </svg>
          <b data-stat="stars" class="tabular-nums text-white">…</b>
          GitHub stars
        </span>
        <span
          class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-5 py-2 text-sm text-neutral-300 backdrop-blur-sm"
        >
          <svg
            class="w-4 h-4 text-white"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="18" r="3"></circle>
            <circle cx="6" cy="6" r="3"></circle>
            <circle cx="18" cy="6" r="3"></circle>
            <path d="M18 9v2a2 2 0 0 1-2 2h-4a2 2 0 0 0-2 2v2"></path>
            <line x1="12" y1="6" x2="12" y2="10"></line>
          </svg>
          <b data-stat="forks" class="tabular-nums text-white">…</b>
          forks
        </span>
        <a
          href="https://github.com/IAHispano/Applio"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-5 py-2 text-sm text-neutral-300 backdrop-blur-sm transition-all duration-200 hover:border-white/30 hover:text-white"
        >
          View repository
          <svg
            class="w-3.5 h-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M7 17 17 7"></path>
            <path d="M7 7h10v10"></path>
          </svg>
        </a>
      </div>

      <div class="mt-10 flex flex-wrap gap-4 items-center justify-center">
        <a
          href="https://github.com/IAHispano/Applio/blob/main/CONTRIBUTING.md"
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-3 bg-white text-black font-medium rounded-full hover:bg-neutral-200 transition-all duration-300 text-sm"
        >
          Contribute on GitHub
        </a>
        <a
          href="https://github.com/IAHispano/Applio/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-3 bg-white/10 backdrop-blur-sm text-white font-medium rounded-full hover:bg-white/20 transition-all duration-300 text-sm"
        >
          Report an issue
        </a>
      </div>
    </div>
  </section>

  {/* blog */}
  <section id="blog" class="relative px-6 py-20">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-end justify-between gap-4 flex-wrap">
        <div>
          <p class="text-sm text-neutral-400 uppercase tracking-widest">News</p>
