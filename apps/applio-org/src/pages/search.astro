---
import BackLink from "../components/BackLink.astro";
import GlowBackground from "../components/GlowBackground.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <GlowBackground />

  <div
    class="relative flex flex-col items-center justify-center min-h-[100dvh] px-6 py-16 max-w-4xl mx-auto animate-fade-in"
  >
    <div class="w-full max-w-2xl mb-8 flex justify-start">
      <BackLink />
    </div>

    <div class="text-center w-full max-w-2xl">
      <h1 class="text-4xl md:text-5xl font-bold text-white tracking-tight">
        Search
      </h1>
      <p class="mt-4 text-base text-neutral-300 max-w-xl mx-auto">
        Quickly find voice conversion models on Google. Enter your search query
        below to get started.
      </p>
    </div>

    {/* search form */}
    <form id="search-form" class="w-full max-w-2xl mt-8">
      <div class="relative flex items-center">
        <input
          type="text"
          id="search-input"
          placeholder="Enter voice name (e.g. Acat)..."
          class="w-full px-6 py-4 bg-white/5 border border-white/10 rounded-2xl text-white placeholder-neutral-500 focus:border-white/30 focus:bg-white/10 transition-all duration-300 pr-32 text-sm md:text-base"
          required
          autocomplete="off"
        />
        <button
          type="submit"
          class="absolute right-2 px-6 py-2.5 bg-white text-black font-semibold rounded-xl hover:bg-neutral-200 transition-all duration-300 text-sm"
        >
          Search
        </button>
      </div>
    </form>

    <div class="mt-12 p-6 bg-white/5 border border-white/10 rounded-2xl max-w-2xl text-neutral-400 text-xs leading-relaxed text-left">
      <h3 class="text-white font-semibold text-sm mb-3 flex items-center gap-2">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-neutral-300"
        >
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
          <line x1="12" y1="9" x2="12" y2="13"></line>
          <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
        Search Disclaimer & Liability Notice
      </h3>
      <p class="mb-3">
        This search utility is provided solely as a convenience to simplify your
        lookup process by redirecting you to external Google search queries.
        Applio does not host, index, distribute, verify, or control any RVC
        models, voice files, or external content.
      </p>
      <p class="mb-3">
        By using this tool, you acknowledge and agree to our
        <a href="/terms-use" class="text-white underline hover:text-neutral-200"
          >Terms of Use</a
        >. You bear full and sole responsibility for any models or content you
        download, train, or process from external sources. You must respect
        intellectual property, copyrights, and privacy rights of all individuals
        and entities, and comply with all applicable local laws and regulations
        governing AI-generated content in your jurisdiction.
      </p>
      <p>
        Applio and its contributors disclaim all liability, direct or indirect,
        for any external content, downloads, misuse, or any unintended
        consequences arising from your search or subsequent use of any models.
      </p>
    </div>
  </div>
</Layout>

<script>
  function initSearch() {
    const form = document.getElementById("search-form");
    const input = document.getElementById("search-input") as HTMLInputElement;

    form?.addEventListener("submit", (e) => {
      e.preventDefault();

      const val = input?.value.trim();

      if (val) {
        const query = `rvc model ${val}`;

        window.open(
          `https://www.google.com/search?q=${encodeURIComponent(query)}`,
          "_blank",
          "noopener,noreferrer"
        );
      }
    });
  }

  document.addEventListener("astro:page-load", initSearch);
</script>