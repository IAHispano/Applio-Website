---
import Icon from "./Icon.astro";
import type { ImageMetadata } from "astro";
import "./media.css";
interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  interfaceName?: string;
  loading?: "eager" | "lazy";
}
const { src, alt, caption, interfaceName, loading = "lazy" } = Astro.props;
---
<figure class="screenshot">
  <image-viewer>
    <a href={src.src} class:list={["screenshot-open", { "screenshot-portrait": src.height > src.width }]} data-image-open aria-label={`Enlarge screenshot: ${alt}`}>
      <img src={src.src} alt={alt} width={src.width} height={src.height} loading={loading} decoding="async" />
      <span class="screenshot-enlarge icon-label" aria-hidden="true"><Icon name="maximize" size={12} /> Expand</span>
    </a>
    <dialog class="image-dialog" aria-label={`Screenshot: ${caption}`} data-pagefind-ignore>
      <div class="image-dialog-toolbar"><span>{interfaceName && `${interfaceName} · `}{caption}</span><button type="button" data-image-close aria-label="Close screenshot"><Icon name="close" /> Close <kbd>Esc</kbd></button></div>
      <div class="image-dialog-scroll"><img src={src.src} alt={alt} width={src.width} height={src.height} loading="lazy" /></div>
      <a href={src.src} target="_blank" rel="noopener noreferrer" class="image-original icon-label">Open full-size image <Icon name="external-link" size={12} /></a>
    </dialog>
  </image-viewer>
  <figcaption>{interfaceName && <span class="screenshot-interface">{interfaceName}</span>}{caption}</figcaption>
</figure>
<script src="./image-viewer.ts"></script>
